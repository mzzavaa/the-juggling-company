---
/**
 * Displays a live juggling pattern animation powered by JugglingLab
 * (https://jugglinglab.org | https://github.com/jkboyce/jugglinglab).
 *
 * The GIF animation is fetched from the JugglingLab public server using
 * siteswap notation. Ball colors use the site's RGB pillar palette.
 *
 * Attribution: JugglingLab by Jack Boyce, open-source juggling pattern tool.
 */
interface Props {
  pattern: string;
  title: string;
  description: string;
  notation?: string;
  pillar?: "brain" | "tech" | "change" | "all";
  width?: number;
  height?: number;
  slowdown?: number;
}

const {
  pattern,
  title,
  description,
  notation,
  pillar = "all",
  width = 260,
  height = 300,
  slowdown = 1.8,
} = Astro.props;

// Pillar accent color for glow and border
const pillarColor: Record<string, string> = {
  brain: "#ff3366",
  tech: "#33cc66",
  change: "#3b6cff",
  all: "#f3f3f8",
};
const accent = pillarColor[pillar];

// JugglingLab GIF server - uses semicolons as param separators
// colors=mixed applies a pre-defined colorful mix (red/orange/blue/etc.)
// bgcolor is not a supported param - omit to avoid rendering errors
const params = [
  `pattern=${encodeURIComponent(pattern)}`,
  `redirect=true`,
  `width=${width}`,
  `height=${height}`,
  `fps=30`,
  `slowdown=${slowdown}`,
  `colors=mixed`,
].join(";");

const gifUrl = `https://jugglinglab.org/anim?${params}`;
---

<div class="juggling-pattern-card group" style={`--accent: ${accent};`}>
  <div class="img-wrap">
    <img
      src={gifUrl}
      alt={`Juggling pattern animation: ${title} (${notation ?? pattern})`}
      width={width}
      height={height}
      loading="lazy"
      class="pattern-gif"
    />
    <div class="glow-overlay" aria-hidden="true"></div>
  </div>

  <div class="card-body">
    <p class="siteswap" aria-label={`Siteswap notation: ${notation ?? pattern}`}>
      {notation ?? pattern}
    </p>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
  </div>
</div>

<style>
  .juggling-pattern-card {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--accent) 30%, var(--color-border));
    background: var(--color-bg-card);
    overflow: hidden;
    transition: box-shadow 240ms ease, transform 240ms ease, border-color 240ms ease;
  }

  .juggling-pattern-card:hover {
    border-color: color-mix(in oklab, var(--accent) 60%, var(--color-border));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 20%, transparent),
      0 8px 32px -8px color-mix(in oklab, var(--accent) 35%, transparent),
      0 24px 64px -16px color-mix(in oklab, var(--accent) 15%, transparent);
    transform: translateY(-3px);
  }

  .img-wrap {
    position: relative;
    background: var(--color-bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
  }

  .pattern-gif {
    display: block;
    position: relative;
    z-index: 1;
    filter:
      drop-shadow(0 0 8px color-mix(in oklab, var(--accent) 50%, transparent))
      drop-shadow(0 0 24px color-mix(in oklab, var(--accent) 25%, transparent))
      brightness(1.15)
      saturate(1.3);
    transition: filter 240ms ease;
  }

  .juggling-pattern-card:hover .pattern-gif {
    filter:
      drop-shadow(0 0 12px color-mix(in oklab, var(--accent) 70%, transparent))
      drop-shadow(0 0 32px color-mix(in oklab, var(--accent) 40%, transparent))
      brightness(1.25)
      saturate(1.5);
  }

  /* Subtle radial glow behind the animation */
  .glow-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      color-mix(in oklab, var(--accent) 8%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .card-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .siteswap {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-fg);
    margin-top: 0.25rem;
  }

  .card-desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }
</style>
