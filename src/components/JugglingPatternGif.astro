---
/**
 * Juggling pattern card backed by a pre-rendered animated GIF.
 *
 * Unlike the canvas-based JugglingPattern.astro (which simulates throws live),
 * this component shows a JugglingLab-rendered GIF with our custom feminine avatar.
 * GIFs live at /animations/pattern-{slug}.gif and are loaded lazily so an
 * out-of-viewport card costs nothing.
 *
 * Animation engine: JugglingLab (© Jack Boyce), GPL-2.0 licensed.
 * https://github.com/jkboyce/jugglinglab
 */
interface Props {
  src: string;
  title: string;
  notation: string;
  description: string;
  difficulty?: "beginner" | "intermediate" | "advanced";
  pillar?: "brain" | "tech" | "change" | "all";
}

const {
  src,
  title,
  notation,
  description,
  difficulty = "beginner",
  pillar = "all",
} = Astro.props;

const pillarColor: Record<string, string> = {
  brain: "var(--color-brain)",
  tech: "var(--color-tech)",
  change: "var(--color-change)",
  all: "var(--color-tech-change)",
};
const accent = pillarColor[pillar];

const difficultyLabel: Record<string, string> = {
  beginner: "Beginner",
  intermediate: "Intermediate",
  advanced: "Advanced",
};
const difficultyDots = { beginner: 1, intermediate: 2, advanced: 3 }[difficulty];

// Difficulty has its own color system, separate from pillar accent
const difficultyColor: Record<string, string> = {
  beginner: "#33cc66",
  intermediate: "#ffcc33",
  advanced: "#ff3366",
};
const pillColor = difficultyColor[difficulty];
---

<article class="pattern-gif-card group" style={`--accent: ${accent}; --pill: ${pillColor};`}>
  <div class="img-wrap">
    <img
      src={src}
      alt={`Animated juggling pattern: ${title}, siteswap ${notation}`}
      loading="lazy"
      decoding="async"
      class="pattern-gif"
    />
    <div class="glow-overlay" aria-hidden="true"></div>

    <span class="difficulty-pill" aria-label={`Difficulty: ${difficultyLabel[difficulty]}`}>
      <span class="dots" aria-hidden="true">
        {Array.from({ length: 3 }, (_, i) => (
          <span class:list={["dot", { on: i < difficultyDots }]}></span>
        ))}
      </span>
      {difficultyLabel[difficulty]}
    </span>
  </div>

  <div class="card-body">
    <p class="siteswap" aria-label={`Siteswap notation: ${notation}`}>
      Siteswap {notation}
    </p>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
  </div>
</article>

<style>
  .pattern-gif-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--accent) 25%, var(--color-border));
    background: var(--color-bg-card);
    overflow: hidden;
    transition: box-shadow 240ms ease, transform 240ms ease, border-color 240ms ease;
  }
  .pattern-gif-card:hover {
    border-color: color-mix(in oklab, var(--accent) 60%, var(--color-border));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 20%, transparent),
      0 8px 32px -8px color-mix(in oklab, var(--accent) 35%, transparent),
      0 24px 64px -16px color-mix(in oklab, var(--accent) 15%, transparent);
    transform: translateY(-3px);
  }

  .img-wrap {
    position: relative;
    /* GIFs are all 400×450 (8:9). Match exactly so contain fills the box with no strips. */
    aspect-ratio: 8 / 9;
    background: #080810;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pattern-gif {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    position: relative;
    z-index: 2;
  }

  .glow-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      color-mix(in oklab, var(--accent) 8%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .difficulty-pill {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in oklab, #080810 75%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in oklab, var(--pill) 40%, transparent);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg);
  }
  .dots {
    display: inline-flex;
    gap: 2px;
    align-items: center;
  }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--pill) 25%, var(--color-border));
  }
  .dot.on {
    background: var(--pill);
    box-shadow: 0 0 5px color-mix(in oklab, var(--pill) 70%, transparent);
  }

  .card-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .siteswap {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.85;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-fg);
    line-height: 1.2;
  }
  .card-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin-top: 0.1rem;
  }
</style>
