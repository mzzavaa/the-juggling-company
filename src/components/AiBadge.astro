---
// EU AI Act (Art. 50) marking for AI-generated images. Place inside a
// position:relative container laid over the image. See /ai for the policy.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const TIP = "AI image I created with NotebookLM (now Gemini Notebook)";
---

<span class:list={["ai-badge", className]} tabindex="0" aria-label={TIP} title={TIP}>
  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"
      fill="currentColor"
    />
  </svg>
  <span class="ai-badge__label">AI</span>
  <span class="ai-badge__tip" role="tooltip">{TIP}</span>
</span>

<style>
  .ai-badge {
    position: absolute;
    /* Inset to clear the card's rounded corner so it reads as part of the design */
    top: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, white 16%, transparent);
    background: color-mix(in oklab, black 48%, transparent);
    padding: 0.14rem 0.42rem;
    font-size: 0.5rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in oklab, white 82%, transparent);
    backdrop-filter: blur(4px);
    cursor: help;
    opacity: 0.85;
    transition: opacity 160ms ease;
  }
  .ai-badge:hover,
  .ai-badge:focus-visible {
    opacity: 1;
    outline: none;
  }
  .ai-badge:hover,
  .ai-badge:focus-visible {
    opacity: 1;
    outline: none;
  }
  .ai-badge__label {
    letter-spacing: 0.04em;
  }

  /* Hover / focus explanation */
  .ai-badge__tip {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: max-content;
    max-width: 220px;
    padding: 0.4rem 0.55rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, white 14%, transparent);
    background: #0d0d16;
    color: #e8e8f0;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: normal;
    text-align: left;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translateY(-3px);
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 10;
  }
  .ai-badge:hover .ai-badge__tip,
  .ai-badge:focus-visible .ai-badge__tip {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-badge,
    .ai-badge__tip {
      transition: none;
    }
  }
</style>
