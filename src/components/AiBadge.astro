---
// EU AI Act (Art. 50) marking for AI-generated images. Place inside a
// position:relative container laid over the image. See /ai for the policy.
interface Props {
  /** Compact shows just "AI"; otherwise "AI-generated". */
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className } = Astro.props;
---

<span
  class:list={["ai-badge", className]}
  title="AI-generated image - see our AI disclosure"
  aria-label="This image was generated by AI"
>
  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"
      fill="currentColor"
    />
    <circle cx="18.5" cy="17.5" r="1.6" fill="currentColor" />
  </svg>
  <span>{compact ? "AI" : "AI-generated"}</span>
</span>

<style>
  .ai-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, white 28%, transparent);
    background: color-mix(in oklab, black 62%, transparent);
    padding: 0.15rem 0.5rem;
    font-size: 0.64rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.03em;
    color: white;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
</style>
