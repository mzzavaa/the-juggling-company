---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import AiBadge from "./AiBadge.astro";

interface Props {
  src: ImageMetadata;
  videoSrc?: string;        // /videos/filename.mp4
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  style?: string;
  objectFit?: "cover" | "contain";
  ai?: boolean;             // AI-generated (shows badge); default true
}

const {
  src,
  videoSrc,
  alt,
  width = 700,
  height = 560,
  class: className = "",
  style = "",
  objectFit = "cover",
  ai = true,
} = Astro.props;
---

<span class="ai-image">
  {videoSrc ? (
    <video
      autoplay
      muted
      loop
      playsinline
      class={className}
      style={style}
      aria-label={alt}
    >
      <source src={videoSrc} type="video/mp4" />
      {/* Fallback for browsers that don't support video */}
      <Image src={src} alt={alt} width={width} height={height} class={className} style={style} />
    </video>
  ) : (
    <Image src={src} alt={alt} width={width} height={height} class={className} style={style} />
  )}
  {ai && <AiBadge />}
</span>

<style>
  .ai-image {
    position: relative;
    display: block;
  }
  .ai-image > :global(video),
  .ai-image > :global(img) {
    display: block;
  }
</style>
