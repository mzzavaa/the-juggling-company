---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/lib/format";
import Icon from "./Icon.astro";
import PillarBadge from "./PillarBadge.astro";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;

const accentHex = post.data.pillars.length > 0 ? PILLAR_HEX[blendKey(post.data.pillars)] : "#9696b0";
---

<a
  href={`/blog/${post.id}`}
  class="card group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] transition"
  style={`--card-accent: ${accentHex};`}
>
  {
    post.data.cover && (
      <div class="media-wrap aspect-[16/9] overflow-hidden">
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? post.data.title}
          width={800}
          height={450}
          class="media-img h-full w-full object-cover transition group-hover:scale-105"
          loading="lazy"
        />
        {post.data.coverVideo && (
          <video
            src={post.data.coverVideo}
            class="media-vid absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500"
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          />
        )}
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex flex-wrap items-center gap-3">
      <p class="text-xs uppercase tracking-widest text-[var(--color-muted)]">
        {formatDate(post.data.date)}
      </p>
      {post.data.pillars.length > 0 && <PillarBadge pillars={post.data.pillars} variant="solid" />}
    </div>
    <h3
      class="font-display text-2xl font-bold leading-snug text-[var(--color-fg)]"
    >
      {post.data.title}
    </h3>
    <p class="text-sm text-[var(--color-muted)]">{post.data.summary}</p>
    <span
      class="mt-auto inline-flex items-center gap-1 text-sm font-medium"
      style={`color: ${accentHex};`}
    >
      Read more <Icon name="arrow-right" size={14} />
    </span>
  </div>
</a>

<style>
  .card {
    transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-accent) 30%, transparent),
      0 12px 36px -12px color-mix(in oklab, var(--card-accent) 60%, transparent);
    transform: translateY(-2px);
  }
  .media-wrap {
    position: relative;
  }
  .card:hover .media-vid {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .media-vid {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".card").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>(".media-vid");
    if (!video) return;
    card.addEventListener("mouseenter", () => {
      video.currentTime = 0;
      video.play().catch(() => {});
    });
    card.addEventListener("mouseleave", () => {
      video.pause();
      video.currentTime = 0;
    });
  });
</script>
