---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/lib/format";
import Icon from "./Icon.astro";
import PillarBadge from "./PillarBadge.astro";
import AiCaption from "./AiCaption.astro";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;

const accentHex = post.data.pillars.length > 0 ? PILLAR_HEX[blendKey(post.data.pillars)] : "#9696b0";
---

<a
  href={`/blog/${post.id}`}
  class="card group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] transition"
  style={`--card-accent: ${accentHex};`}
>
  {
    post.data.cover && (
      <div class:list={["media-wrap aspect-[16/9] overflow-hidden", !post.data.coverVideo && "no-vid"]}>
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? post.data.title}
          width={640}
          height={360}
          class="media-img h-full w-full object-cover img-lazy"
          loading="lazy"
          decoding="async"
        />
        {post.data.coverVideo && (
          <video
            src={post.data.coverVideo}
            class="media-vid absolute inset-0 h-full w-full object-cover opacity-0"
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          />
        )}
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex flex-wrap items-center gap-3">
      <p class="text-xs uppercase tracking-widest text-[var(--color-muted)]">
        {formatDate(post.data.date)}
      </p>
      {post.data.pillars.length > 0 && <PillarBadge pillars={post.data.pillars} variant="solid" />}
      {post.data.aiGenerated && <AiCaption />}
    </div>
    <h3
      class="font-display text-2xl font-bold leading-snug text-[var(--color-fg)]"
    >
      {post.data.title}
    </h3>
    <p class="text-sm text-[var(--color-muted)]">{post.data.summary}</p>
    <span
      class="mt-auto inline-flex items-center gap-1 text-sm font-medium"
      style={`color: ${accentHex};`}
    >
      Read more <Icon name="arrow-right" size={14} />
    </span>
  </div>
</a>

<style>
  .card {
    transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-accent) 30%, transparent),
      0 12px 36px -12px color-mix(in oklab, var(--card-accent) 60%, transparent);
    transform: translateY(-2px);
  }
  .media-wrap {
    position: relative;
    /* Shimmer placeholder shown while image loads */
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--card-accent, #9696b0) 8%, #12121e) 0%,
      #12121e 50%,
      color-mix(in oklab, var(--card-accent, #9696b0) 5%, #12121e) 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.6s ease infinite;
  }

  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Image starts invisible; JS adds .is-loaded when decoded */
  .img-lazy {
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .img-lazy.is-loaded {
    opacity: 1;
  }
  /* Once loaded, stop the shimmer animation to save CPU */
  .media-wrap:has(.is-loaded) {
    animation: none;
    background: none;
  }

  /* Video fades in only after JS confirms a real frame is ready */
  .media-vid {
    transition: opacity 400ms ease;
  }
  .media-vid.is-playing {
    opacity: 1;
  }

  /* No-video fallback: subtle image pan + accent gradient wash */
  .no-vid .media-img {
    transition: transform 400ms ease;
  }
  .card:hover .no-vid .media-img {
    transform: scale(1.05);
  }
  .no-vid {
    --accent: var(--card-accent, #9696b0);
  }
  .no-vid::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms ease;
    background: linear-gradient(
      150deg,
      color-mix(in oklab, var(--accent) 50%, transparent) 0%,
      color-mix(in oklab, var(--accent) 22%, transparent) 55%,
      transparent 100%
    );
  }
  .card:hover .no-vid::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .media-vid { display: none; }
    .no-vid .media-img { transition: none; }
    .img-lazy { opacity: 1; }
    .media-wrap { animation: none; }
  }
</style>

<script>
  // Fade in images once they're decoded - works for both cached and fresh loads.
  // Also reveal on error and after a timeout so a slow/failed load can never
  // leave a card stuck on the blank shimmer placeholder.
  document.querySelectorAll<HTMLImageElement>(".img-lazy").forEach((img) => {
    const reveal = () => img.classList.add("is-loaded");
    if (img.complete && img.naturalWidth > 0) {
      reveal();
    } else {
      img.addEventListener("load", reveal, { once: true });
      img.addEventListener("error", reveal, { once: true });
      window.setTimeout(reveal, 3000);
    }
  });

  document.querySelectorAll<HTMLAnchorElement>(".card").forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>(".media-vid");
    if (!video) return;

    let active = false;

    card.addEventListener("mouseenter", () => {
      active = true;
      video.currentTime = 0;
      video.play().catch(() => {});

      // Only show the video once a real frame has been rendered.
      // "playing" fires after the first frame is committed to the GPU -
      // guarantees no black flash regardless of decode speed.
      video.addEventListener(
        "playing",
        () => { if (active) video.classList.add("is-playing"); },
        { once: true }
      );
    });

    card.addEventListener("mouseleave", () => {
      active = false;
      video.classList.remove("is-playing");
      video.pause();
      video.currentTime = 0;
    });
  });
</script>
