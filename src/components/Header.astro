---
import { primaryNav, site } from "@/lib/site";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);

const isGroupActive = (item: (typeof primaryNav)[number]) => {
  if (isActive(item.href)) return true;
  return item.children?.some((c) => isActive(c.href)) ?? false;
};
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-xl"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 md:px-6">

    <!-- Logo -->
    <a
      href="/"
      class="group inline-flex shrink-0 items-center gap-2.5"
      aria-label="theJugglingCompany.com - home"
    >
      <svg aria-hidden="true" class="h-8 w-auto shrink-0" viewBox="120 400 1900 1200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="logoYellow" cx="35%" cy="35%" r="70%">
            <stop offset="0%" stop-color="#ffee88"/>
            <stop offset="60%" stop-color="#ffcc00"/>
            <stop offset="100%" stop-color="#cc9900"/>
          </radialGradient>
          <radialGradient id="logoGreen" cx="35%" cy="35%" r="70%">
            <stop offset="0%" stop-color="#7fdf99"/>
            <stop offset="60%" stop-color="#33cc66"/>
            <stop offset="100%" stop-color="#0a8033"/>
          </radialGradient>
          <radialGradient id="logoBlue" cx="35%" cy="35%" r="70%">
            <stop offset="0%" stop-color="#7fa3ff"/>
            <stop offset="60%" stop-color="#3b6cff"/>
            <stop offset="100%" stop-color="#0033cc"/>
          </radialGradient>
        </defs>
        <path fill="currentColor" fill-rule="evenodd" d="M 1853 670 L 1846 649 L 1833 622 L 1813 593 L 1793 573 L 1775 559 L 1746 543 L 1726 535 L 1693 526 L 1656 521 L 1602 521 L 1534 530 L 1491 540 L 1398 569 L 1318 598 L 1223 636 L 1156 666 L 1008 740 L 940 776 L 823 842 L 689 922 L 629 956 L 586 914 L 531 866 L 500 846 L 462 828 L 428 819 L 414 817 L 387 817 L 359 821 L 329 831 L 301 846 L 276 865 L 247 896 L 221 936 L 210 959 L 199 996 L 196 1018 L 196 1048 L 200 1070 L 207 1090 L 215 1104 L 225 1117 L 244 1133 L 261 1142 L 279 1148 L 306 1152 L 327 1152 L 359 1148 L 382 1143 L 440 1123 L 502 1095 L 618 1034 L 667 1081 L 728 1129 L 765 1152 L 795 1167 L 834 1182 L 881 1195 L 923 1201 L 976 1201 L 997 1199 L 1038 1191 L 1071 1182 L 1115 1166 L 1117 1164 L 1138 1156 L 1201 1123 L 1231 1105 L 1269 1079 L 1322 1038 L 1332 1032 L 1336 1028 L 1336 1024 L 1331 1023 L 1327 1025 L 1318 1033 L 1283 1057 L 1243 1082 L 1220 1094 L 1217 1097 L 1174 1118 L 1133 1135 L 1104 1145 L 1063 1155 L 1016 1161 L 979 1162 L 942 1159 L 911 1153 L 867 1140 L 865 1138 L 838 1127 L 794 1102 L 756 1076 L 707 1035 L 674 1003 L 674 1001 L 1032 789 L 1127 736 L 1286 654 L 1350 625 L 1411 600 L 1470 579 L 1520 565 L 1565 556 L 1615 551 L 1656 552 L 1691 557 L 1731 570 L 1744 576 L 1766 590 L 1781 603 L 1798 622 L 1811 642 L 1821 663 L 1830 693 L 1834 716 L 1835 768 L 1829 819 L 1826 827 L 1821 853 L 1811 884 L 1797 919 L 1782 951 L 1744 1017 L 1713 1062 L 1663 1125 L 1626 1166 L 1557 1233 L 1492 1287 L 1430 1331 L 1353 1377 L 1281 1413 L 1221 1438 L 1169 1456 L 1079 1480 L 1029 1489 L 974 1495 L 930 1497 L 875 1496 L 848 1494 L 836 1491 L 813 1489 L 750 1475 L 678 1451 L 624 1427 L 570 1398 L 524 1369 L 480 1336 L 430 1289 L 377 1227 L 372 1228 L 369 1232 L 370 1236 L 419 1297 L 456 1334 L 510 1377 L 554 1406 L 613 1439 L 655 1459 L 717 1483 L 765 1497 L 790 1503 L 801 1504 L 809 1507 L 830 1509 L 840 1512 L 872 1514 L 878 1516 L 949 1517 L 1018 1512 L 1081 1502 L 1085 1500 L 1120 1493 L 1178 1477 L 1220 1463 L 1258 1448 L 1305 1427 L 1349 1405 L 1407 1372 L 1483 1322 L 1556 1264 L 1594 1230 L 1666 1156 L 1717 1094 L 1764 1027 L 1810 947 L 1835 889 L 1843 866 L 1844 859 L 1848 849 L 1850 836 L 1853 829 L 1855 812 L 1858 803 L 1860 775 L 1862 767 L 1862 719 Z M 571 985 L 569 989 L 483 1034 L 433 1057 L 382 1077 L 341 1087 L 309 1089 L 294 1087 L 285 1084 L 273 1077 L 265 1068 L 261 1061 L 256 1045 L 255 1014 L 261 985 L 269 963 L 287 932 L 301 914 L 315 900 L 329 889 L 355 875 L 376 869 L 408 868 L 420 870 L 443 878 L 467 891 L 491 908 L 537 950 Z"/>
        <g>
          <circle r="100" fill="url(#logoYellow)">
            <animateMotion dur="2.5s" fill="freeze" path="M 1420 580 C 1680 545 1862 630 1862 760 C 1862 860 1820 1000 1720 1120 C 1620 1240 1500 1360 1370 1430 C 1240 1490 1080 1510 920 1505 C 760 1500 640 1450 600 1350 C 560 1250 620 1120 700 1015 C 680 988 660 970 640 960 C 600 940 490 895 390 940 C 290 985 265 1065 305 1130 C 345 1195 450 1165 545 1100 C 605 1050 635 1005 640 960 C 690 935 830 880 990 820 C 1140 768 1280 660 1420 580"/>
          </circle>
        </g>
        <g>
          <circle r="100" fill="url(#logoGreen)">
            <animateMotion dur="2.8s" fill="freeze" path="M 1800 940 C 1820 1000 1760 1080 1720 1120 C 1620 1240 1500 1360 1370 1430 C 1240 1490 1080 1510 920 1505 C 760 1500 640 1450 600 1350 C 560 1250 620 1120 700 1015 C 680 988 660 970 640 960 C 600 940 490 895 390 940 C 290 985 265 1065 305 1130 C 345 1195 450 1165 545 1100 C 605 1050 635 1005 640 960 C 690 935 830 880 990 820 C 1140 768 1280 660 1420 580 C 1680 545 1862 630 1862 760 C 1862 855 1845 910 1800 940"/>
          </circle>
        </g>
        <g>
          <circle r="100" fill="url(#logoBlue)">
            <animateMotion dur="2.3s" fill="freeze" path="M 1000 810 C 890 870 780 930 700 1015 C 680 988 660 970 640 960 C 600 940 490 895 390 940 C 290 985 265 1065 305 1130 C 345 1195 450 1165 545 1100 C 605 1050 635 1005 640 960 C 690 935 830 880 990 820 C 1140 768 1280 660 1420 580 C 1680 545 1862 630 1862 760 C 1862 860 1820 1000 1720 1120 C 1620 1240 1500 1360 1370 1430 C 1240 1490 1080 1510 920 1505 C 760 1500 640 1450 600 1350 C 560 1250 620 1120 700 1015 C 700 1000 850 900 1000 810"/>
          </circle>
        </g>
      </svg>
      <span class="font-display text-sm font-bold tracking-tight text-[var(--color-fg)] transition-colors">
        <span class="text-[var(--color-muted)]">the</span>JugglingCompany<span class="text-[var(--color-muted)]">.com</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-0.5">
        {
          primaryNav.map((item, i) => {
            const active = isGroupActive(item);
            const hasMega = !!item.children?.length;
            const panelAlign = i === 0 ? "left" : "center";
            return (
              <li class={hasMega ? "mega-item group relative" : "relative"} data-align={panelAlign}>
                {hasMega ? (
                  <button
                    type="button"
                    class:list={[
                      "mega-trigger inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition",
                      active
                        ? "text-[var(--color-fg)]"
                        : "text-[var(--color-muted)] hover:text-[var(--color-fg)]",
                    ]}
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {item.label}
                    <svg class="h-3.5 w-3.5 opacity-60 transition-transform duration-200 mega-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {active && (
                      <span
                        class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-[var(--color-brain-tech)]"
                        aria-hidden="true"
                      />
                    )}
                  </button>
                ) : (
                  <a
                    href={item.href}
                    class:list={[
                      "group relative inline-flex items-center rounded-md px-3 py-2 text-sm font-medium transition",
                      active
                        ? "text-[var(--color-fg)]"
                        : "text-[var(--color-muted)] hover:text-[var(--color-fg)]",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    {item.label}
                    {active && (
                      <span
                        class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-[var(--color-brain-tech)]"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                )}

                {hasMega && (
                  <div
                    class="mega-panel pointer-events-none absolute top-full z-50 pt-2 opacity-0 transition-all duration-200"
                    role="region"
                  >
                    <div
                      class="overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] shadow-2xl"
                      style="min-width: 480px;"
                    >
                      <div
                        class="grid divide-x divide-[var(--color-border)]"
                        style={`grid-template-columns: repeat(${item.children!.length}, 1fr);`}
                      >
                        {item.children!.map((child) => (
                          <a
                            href={child.href}
                            class:list={[
                              "group/child flex flex-col gap-3 p-5 transition hover:bg-[var(--color-bg-elevated)]",
                              isActive(child.href) ? "bg-[var(--color-bg-elevated)]" : "",
                            ]}
                          >
                            <span
                              class="inline-flex h-11 w-11 items-center justify-center rounded-xl transition-transform group-hover/child:scale-110"
                              style={`background: color-mix(in oklab, ${child.accent} 18%, var(--color-bg-elevated)); color: ${child.accent};`}
                            >
                              <Icon name={child.icon as any} size={22} />
                            </span>
                            <span>
                              <span class="block text-sm font-semibold text-[var(--color-fg)]">
                                {child.label}
                              </span>
                              <span class="mt-1 block text-xs leading-relaxed text-[var(--color-muted)]">
                                {child.description}
                              </span>
                            </span>
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <SocialLinks class="hidden lg:flex" />
      <ThemeToggle />
      <button
        type="button"
        class="nav-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="nav-toggle-open"><Icon name="menu" size={16} /></span>
        <span class="nav-toggle-close hidden"><Icon name="x" size={16} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    id="mobile-nav"
    class="mobile-nav hidden border-t border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-4 md:hidden"
    aria-label="Mobile"
  >
    <ul class="flex flex-col gap-0.5">
      {
        primaryNav.map((item) => {
          const active = isGroupActive(item);
          const hasMega = !!item.children?.length;
          return (
            <li>
              {hasMega ? (
                <details class="group/details">
                  <summary
                    class:list={[
                      "flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2.5 text-base font-medium transition select-none",
                      active
                        ? "bg-[var(--color-bg-elevated)] text-[var(--color-fg)]"
                        : "text-[var(--color-muted)] hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-fg)]",
                    ]}
                  >
                    {item.label}
                    <svg
                      class="h-4 w-4 opacity-60 transition-transform group-open/details:rotate-180"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul class="mt-1 ml-3 flex flex-col gap-0.5 border-l border-[var(--color-border)] pl-3">
                    {item.children!.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            "flex items-center gap-2 rounded-md px-3 py-2 text-sm transition",
                            isActive(child.href)
                              ? "text-[var(--color-fg)] font-medium"
                              : "text-[var(--color-muted)] hover:text-[var(--color-fg)]",
                          ]}
                        >
                          <span
                            class="inline-block h-1.5 w-1.5 shrink-0 rounded-full"
                            style={`background: ${child.accent};`}
                            aria-hidden="true"
                          />
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-3 rounded-md px-3 py-2.5 text-base font-medium transition",
                    active
                      ? "bg-[var(--color-bg-elevated)] text-[var(--color-fg)]"
                      : "text-[var(--color-muted)] hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-fg)]",
                  ]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
    <div class="mt-4 border-t border-[var(--color-border)] pt-4">
      <SocialLinks variant="icons" />
    </div>
  </nav>
</header>

<style>
  /* Left-anchored panel (first nav item) */
  [data-align="left"] .mega-panel {
    left: 0;
    transform: translateY(-8px);
  }
  [data-align="left"]:is(:hover, :focus-within) .mega-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Center-anchored panel */
  [data-align="center"] .mega-panel {
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
  }
  [data-align="center"]:is(:hover, :focus-within) .mega-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .mega-item:is(:hover, :focus-within) .mega-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  /* Mobile hamburger toggle */
  document.querySelectorAll<HTMLButtonElement>(".nav-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const nav = document.getElementById("mobile-nav");
      if (!nav) return;
      const open = nav.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!open));
      btn.querySelector(".nav-toggle-open")?.classList.toggle("hidden");
      btn.querySelector(".nav-toggle-close")?.classList.toggle("hidden");
    });
  });

  /* Keyboard: Escape closes megamenu */
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      (document.activeElement as HTMLElement)?.blur();
    }
  });
</script>
