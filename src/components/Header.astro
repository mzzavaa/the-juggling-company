---
import { primaryNav, site } from "@/lib/site";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);

const pillarForNav: Record<string, string> = {
  Ideas: "var(--color-brain)",
  Videos: "var(--color-tech)",
  Talks: "var(--color-tech)",
  Services: "var(--color-brain-change)",
  Locations: "var(--color-tech-change)",
  Blog: "var(--color-brain-tech)",
  About: "var(--color-all)",
};
---

<header
  class="sticky top-0 z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-xl"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3.5 md:px-6">
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 font-display text-base font-semibold tracking-tight text-[var(--color-fg)]"
      aria-label={`${site.name} — home`}
    >
      <svg aria-hidden="true" class="h-7 w-auto" viewBox="0 0 260 130" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
        <path stroke-width="4" d="M 70 65 C 56 50 34 32 20 40 C 6 48 10 70 34 70 C 54 70 64 65 70 65 C 80 65 114 50 154 34 C 188 20 238 22 244 52 C 250 82 230 104 192 102 C 155 100 124 86 106 74 C 96 66 100 57 120 56 C 148 54 210 64 244 56"/>
        <rect x="146" y="26" width="16" height="16" stroke-width="2"/>
        <circle cx="154" cy="34" r="6.5" fill="currentColor" stroke="none"/>
        <rect x="98" y="66" width="16" height="16" stroke-width="2"/>
        <circle cx="106" cy="74" r="6.5" fill="currentColor" stroke="none"/>
        <rect x="128" y="82" width="16" height="16" stroke-width="2"/>
        <circle cx="136" cy="90" r="6.5" fill="currentColor" stroke="none"/>
      </svg>
      <span>The Juggling Co.</span>
    </a>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {
          primaryNav.map((item) => {
            const accent = pillarForNav[item.label] ?? "var(--color-brain-tech)";
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "group relative inline-flex items-center rounded-md px-3 py-2 text-sm font-medium transition",
                    active
                      ? "text-[var(--color-fg)]"
                      : "text-[var(--color-muted)] hover:text-[var(--color-fg)]",
                  ]}
                  aria-current={active ? "page" : undefined}
                  style={`--nav-accent: ${accent};`}
                >
                  <span
                    class="absolute inset-x-3 -bottom-px h-0.5 origin-left scale-x-0 transition-transform duration-200 group-hover:scale-x-100"
                    style="background: var(--nav-accent);"
                    aria-hidden="true"
                  ></span>
                  {active && (
                    <span
                      class="absolute inset-x-3 -bottom-px h-0.5"
                      style="background: var(--nav-accent);"
                      aria-hidden="true"
                    />
                  )}
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <SocialLinks class="hidden lg:flex" />
      <ThemeToggle />
      <button
        type="button"
        class="nav-toggle inline-flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="nav-toggle-open"><Icon name="menu" size={18} /></span>
        <span class="nav-toggle-close hidden"><Icon name="x" size={18} /></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="mobile-nav hidden border-t border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-4 md:hidden"
    aria-label="Mobile"
  >
    <ul class="flex flex-col gap-1">
      {
        primaryNav.map((item) => {
          const accent = pillarForNav[item.label] ?? "var(--color-brain-tech)";
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  "flex items-center gap-3 rounded-md px-3 py-2 text-base font-medium transition",
                  active
                    ? "bg-[var(--color-bg-elevated)] text-[var(--color-fg)]"
                    : "text-[var(--color-muted)] hover:bg-[var(--color-bg-elevated)] hover:text-[var(--color-fg)]",
                ]}
                aria-current={active ? "page" : undefined}
              >
                <span
                  class="inline-block h-2 w-2 rounded-full"
                  style={`background: ${accent};`}
                  aria-hidden="true"
                />
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="mt-4 border-t border-[var(--color-border)] pt-4">
      <SocialLinks variant="icons" />
    </div>
  </nav>
</header>

<style>
  .logo-dots {
    position: relative;
    width: 28px;
    height: 18px;
  }
  .logo-dot {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    top: 2px;
    mix-blend-mode: screen;
    transition: transform 220ms ease;
  }
  .logo-dot:nth-child(1) { left: 0; }
  .logo-dot--mid { left: 7px; }
  .logo-dot:nth-child(3) { left: 14px; }
  a:hover .logo-dot:nth-child(1) { transform: translate(-2px, -1px); }
  a:hover .logo-dot--mid { transform: translate(0, 1px); }
  a:hover .logo-dot:nth-child(3) { transform: translate(2px, -1px); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".nav-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const nav = document.getElementById("mobile-nav");
      if (!nav) return;
      const open = nav.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!open));
      btn.querySelector(".nav-toggle-open")?.classList.toggle("hidden");
      btn.querySelector(".nav-toggle-close")?.classList.toggle("hidden");
    });
  });
</script>
