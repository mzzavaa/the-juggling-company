---
import { footerNav, primaryNav, site } from "@/lib/site";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
  <div class="rgb-stripe" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-4 md:px-6">
    <div class="md:col-span-2">
      <p class="font-display text-lg font-semibold tracking-tight">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm text-[var(--color-muted)]">{site.description}</p>
      <div class="mt-5">
        <SocialLinks />
      </div>
    </div>

    <nav aria-label="Site">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Site</p>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {
          primaryNav.map((item) => (
            <li>
              <a class="text-[var(--color-fg)] hover:text-[var(--color-brain-tech)]" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="More">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">More</p>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {
          footerNav.map((item) => (
            <li>
              <a class="text-[var(--color-fg)] hover:text-[var(--color-brain-tech)]" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div
    class="border-t border-[var(--color-border)] px-4 py-6 text-center text-xs text-[var(--color-muted)] md:px-6"
  >
    <p>&copy; {year} {site.name} · Built with Astro · <span class="rgb-text font-semibold">brain · tech · change</span></p>
    <p class="mt-2">
      Pattern animations adapted from
      <a href="https://jugglinglab.org" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[var(--color-fg)]">JugglingLab</a>
      by Jack Boyce (open source) - custom figure and dark theme by The Juggling Company.
    </p>
  </div>
</footer>

<style>
  .rgb-stripe {
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--color-brain) 0%,
      var(--color-brain-tech) 25%,
      var(--color-tech) 50%,
      var(--color-tech-change) 75%,
      var(--color-change) 100%
    );
  }
</style>
