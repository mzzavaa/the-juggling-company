---
interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<blockquote class="pull-quote my-10 border-l-4 border-[var(--color-accent,#33cc66)] pl-6">
  <p class="font-display text-xl font-medium italic leading-relaxed text-[var(--color-fg)] md:text-2xl">
    <slot />
  </p>
  {attribution && (
    <cite class="mt-3 block text-sm not-italic text-[var(--color-muted)]">{attribution}</cite>
  )}
</blockquote>
