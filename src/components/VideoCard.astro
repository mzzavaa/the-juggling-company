---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import PillarBadge from "./PillarBadge.astro";
import { formatDuration } from "@/lib/format";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

interface Props {
  video: CollectionEntry<"video">;
}

const { video } = Astro.props;
const { source, externalId, title, durationSec, pillars } = video.data;

const thumbUrl =
  source === "youtube"
    ? `https://i.ytimg.com/vi/${externalId}/hqdefault.jpg`
    : "/images/3.png";

const sourceLabel: Record<typeof source, string> = {
  youtube: "YouTube",
  tiktok: "TikTok",
  instagram: "Instagram",
};

const sourceIcon: Record<typeof source, "youtube" | "music" | "instagram"> = {
  youtube: "youtube",
  tiktok: "music",
  instagram: "instagram",
};

const accentHex = pillars.length > 0 ? PILLAR_HEX[blendKey(pillars)] : "#9696b0";
---

<a
  href={`/videos/${video.id}`}
  class="card group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] transition"
  style={`--card-accent: ${accentHex};`}
>
  <div class="relative aspect-video overflow-hidden bg-black">
    <img
      src={thumbUrl}
      alt=""
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition group-hover:scale-105"
    />
    <span
      class="absolute left-2 top-2 inline-flex items-center gap-1 rounded-full bg-black/70 px-2 py-1 text-xs text-white"
    >
      <Icon name={sourceIcon[source]} size={12} />
      {sourceLabel[source]}
    </span>
    <span class="absolute bottom-2 right-2 rounded bg-black/70 px-2 py-1 text-xs text-white">
      {formatDuration(durationSec)}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    {pillars.length > 0 && <PillarBadge pillars={pillars} variant="solid" />}
    <h3
      class="font-display text-lg font-semibold leading-snug text-[var(--color-fg)] transition group-hover:text-[var(--color-fg)]"
    >
      {title}
    </h3>
  </div>
</a>

<style>
  .card {
    transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-accent) 30%, transparent),
      0 12px 36px -12px color-mix(in oklab, var(--card-accent) 60%, transparent);
    transform: translateY(-2px);
  }
</style>
