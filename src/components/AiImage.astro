---
// Wraps an <Image> and shows a clear "AI-generated" caption beneath it (EU AI
// Act disclosure, not overlaid on the art). Pass ai={false} for real photos.
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import AiCaption from "./AiCaption.astro";

type Props = ComponentProps<typeof Image> & { ai?: boolean; wrapperClass?: string };
const { ai = true, wrapperClass, ...imageProps } = Astro.props as Props;
---

<span class:list={["ai-image", wrapperClass]}>
  <Image {...imageProps} />
  {ai && <AiCaption class="ai-image__cap" />}
</span>

<style>
  .ai-image {
    display: block;
  }
  .ai-image > :global(img) {
    display: block;
  }
  .ai-image__cap {
    margin-top: 0.45rem;
  }
</style>
