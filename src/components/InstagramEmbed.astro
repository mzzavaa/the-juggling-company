---
import Icon from "./Icon.astro";

interface Props {
  postId: string;
  title: string;
  externalUrl: string;
}

const { postId, title, externalUrl } = Astro.props;
---

<div
  class="instagram-embed-wrapper relative w-full overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6"
  data-post-id={postId}
  data-external-url={externalUrl}
>
  <button
    type="button"
    class="instagram-embed-trigger flex w-full flex-col items-center gap-3 py-12 text-center"
    aria-label={`Load Instagram post: ${title}`}
  >
    <span
      class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-accent)] text-[var(--color-accent-fg)]"
    >
      <Icon name="instagram" size={28} />
    </span>
    <span class="font-medium text-[var(--color-fg)]">Load Instagram post</span>
    <span class="text-sm text-[var(--color-muted)]">{title}</span>
    <a
      href={externalUrl}
      class="mt-2 inline-flex items-center gap-1 text-sm text-[var(--color-accent)] hover:underline"
      rel="noopener"
    >
      Open on Instagram <Icon name="external-link" size={14} />
    </a>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".instagram-embed-wrapper").forEach((wrapper) => {
    const trigger = wrapper.querySelector<HTMLButtonElement>(".instagram-embed-trigger");
    const id = wrapper.dataset.postId;
    if (!trigger || !id) return;
    trigger.addEventListener("click", () => {
      const blockquote = document.createElement("blockquote");
      blockquote.className = "instagram-media";
      blockquote.setAttribute("data-instgrm-permalink", `https://www.instagram.com/p/${id}/`);
      blockquote.setAttribute("data-instgrm-version", "14");
      wrapper.replaceChildren(blockquote);
      const script = document.createElement("script");
      script.async = true;
      script.src = "https://www.instagram.com/embed.js";
      document.body.appendChild(script);
    });
  });
</script>
