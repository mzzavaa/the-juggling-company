---
// EU AI Act (Art. 50) disclosure styled as a small, light image caption
// (Bildbeschreibung). The short visible label stays understated; the detail
// lives in the hover/focus overlay. See /ai for the full policy.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const TIP = "AI image I created with NotebookLM (now Gemini Notebook).";
---

<span class:list={["ai-caption", className]} tabindex="0" aria-label={`AI-generated. ${TIP}`}>
  AI-generated
  <span class="ai-caption__tip" role="tooltip">{TIP}</span>
</span>

<style>
  .ai-caption {
    position: relative;
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: color-mix(in oklab, var(--color-fg) 40%, transparent);
    cursor: help;
  }

  /* Detail overlay on hover / focus */
  .ai-caption__tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    width: max-content;
    max-width: 220px;
    padding: 0.4rem 0.55rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in oklab, white 14%, transparent);
    background: #0d0d16;
    color: #e8e8f0;
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: normal;
    text-align: left;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translateY(3px);
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 20;
  }
  .ai-caption:hover .ai-caption__tip,
  .ai-caption:focus-visible .ai-caption__tip {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-caption__tip {
      transition: none;
    }
  }
</style>
