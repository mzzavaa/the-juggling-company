---
import Icon from "./Icon.astro";

interface Props {
  type?: "info" | "warning" | "success";
  title?: string;
}

const { type = "info", title } = Astro.props;

const styles: Record<NonNullable<Props["type"]>, string> = {
  info: "border-[var(--color-accent)] bg-[var(--color-accent)]/8",
  warning: "border-amber-500 bg-amber-500/8",
  success: "border-emerald-500 bg-emerald-500/8",
};

const iconName =
  type === "warning" ? "sparkles" : type === "success" ? "circle-check" : "sparkles";
---

<aside class:list={["callout my-6 rounded-lg border-l-4 p-4 pl-5", styles[type]]} role="note">
  <div class="flex items-start gap-3">
    <span class="mt-0.5 text-[var(--color-accent)]">
      <Icon name={iconName} size={18} />
    </span>
    <div class="flex-1">
      {title && <p class="mb-1 font-semibold text-[var(--color-fg)]">{title}</p>}
      <div class="text-[var(--color-fg)]"><slot /></div>
    </div>
  </div>
</aside>
