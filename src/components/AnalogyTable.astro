---
interface Row {
  juggling: string;
  analogue: string;
}

interface Props {
  /** Title of the right-hand concept domain (e.g. "Tech", "Change Management"). */
  domain?: string;
  /** Two-column form: objects with `juggling` and `analogue`. Free form: one array of cells per row, used with `headers`. */
  rows: Row[] | string[][];
  /** Column titles for the free form, any number of columns. */
  headers?: string[];
  caption?: string;
}

const { domain, rows, headers, caption } = Astro.props;

// Normalise both forms into header cells and rows of cells.
const headerCells = headers ?? ["Juggling", domain ?? ""];
const bodyRows = rows.map((row) => (Array.isArray(row) ? row : [row.juggling, row.analogue]));
---

<figure class="my-8 overflow-hidden rounded-lg border border-[var(--color-border)]">
  <table class="w-full border-collapse text-left text-sm">
    <thead class="bg-[var(--color-bg-elevated)] text-[var(--color-fg)]">
      <tr>
        {
          headerCells.map((cell) => (
            <th scope="col" class="border-b border-[var(--color-border)] px-4 py-3 font-semibold">
              {cell}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        bodyRows.map((cells, idx) => (
          <tr class={idx % 2 === 0 ? "" : "bg-[var(--color-bg-elevated)]/40"}>
            {cells.map((cell) => (
              <td class="border-b border-[var(--color-border)] px-4 py-3 align-top">{cell}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    caption && (
      <figcaption class="bg-[var(--color-bg-elevated)] px-4 py-2 text-xs text-[var(--color-muted)]">
        {caption}
      </figcaption>
    )
  }
</figure>
