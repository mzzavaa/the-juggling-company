---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PillarBadge from "@/components/PillarBadge.astro";
import AiCaption from "@/components/AiCaption.astro";
import { formatDate, readingTimeMinutes } from "@/lib/format";
import { getPosts } from "@/lib/content";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingMinutes = readingTimeMinutes(post.body ?? "");

const pKey = blendKey(post.data.pillars);
const accentHex = PILLAR_HEX[pKey];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Linda Mohamed" },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedAt={post.data.date}
  jsonLd={articleJsonLd}
  image={post.data.cover?.src}
>
  <header
    class="post-hero relative overflow-hidden"
    style={`--accent: ${accentHex};`}
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute -left-20 top-0 h-[20rem] w-[20rem] rounded-full opacity-40 blur-3xl"
        style={`background: ${accentHex};`}
      ></div>
    </div>
    <div class="mx-auto max-w-4xl px-4 py-14 md:px-6 lg:px-10">
      <p class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-widest text-[var(--color-muted)]">
        <a href="/blog" class="transition hover:text-[var(--color-fg)]">Blog</a>
        <span>·</span>
        <span>{formatDate(post.data.date)}</span>
        <span>·</span>
        <span>{readingMinutes} min read</span>
        {post.data.pillars.length > 0 && <PillarBadge pillars={post.data.pillars} variant="solid" />}
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight md:text-5xl">{post.data.title}</h1>
      <p class="mt-3 text-lg text-[var(--color-muted)]">{post.data.summary}</p>
    </div>
  </header>

  <article class="mx-auto max-w-4xl px-4 py-12 md:px-6 lg:px-10" data-pillar={pKey}>
    {
      post.data.cover && (
        <div class="mb-8">
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            width={1280}
            height={720}
            class="aspect-[16/9] w-full rounded-xl object-cover"
          />
          {post.data.aiGenerated && <AiCaption class="mt-2" />}
        </div>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-hero {
    border-bottom: 4px solid var(--accent);
  }
</style>
