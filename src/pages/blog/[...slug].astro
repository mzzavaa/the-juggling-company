---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PillarBadge from "@/components/PillarBadge.astro";
import { formatDate, readingTimeMinutes } from "@/lib/format";
import { getPosts } from "@/lib/content";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingMinutes = readingTimeMinutes(post.body ?? "");

const pKey = blendKey(post.data.pillars);
const accentHex = PILLAR_HEX[pKey];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Linda Mohamed" },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedAt={post.data.date}
  jsonLd={articleJsonLd}
>
  <div class="post-stripe" style={`background: ${accentHex};`} aria-hidden="true"></div>

  <article class="mx-auto max-w-3xl px-4 py-12 md:px-6" data-pillar={pKey}>
    <p class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
      <a href="/blog" class="hover:text-[var(--color-fg)]">Blog</a>
      <span>·</span>
      <span>{formatDate(post.data.date)}</span>
      <span>·</span>
      <span>{readingMinutes} min read</span>
      {post.data.pillars.length > 0 && <PillarBadge pillars={post.data.pillars} variant="solid" />}
    </p>
    {
      post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          width={1280}
          height={720}
          class="my-8 aspect-[16/9] w-full rounded-xl object-cover"
        />
      )
    }
    <h1 class="mt-4 font-display text-4xl font-bold tracking-tight">{post.data.title}</h1>
    <p class="mt-3 text-lg text-[var(--color-muted)]">{post.data.summary}</p>
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-stripe { height: 4px; width: 100%; }
</style>
