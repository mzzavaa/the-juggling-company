---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JugglingCascade from "@/components/JugglingCascade.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { site } from "@/lib/site";
---

<BaseLayout
  title="About"
  description="Linda Mohamed (@mrs_lee_g) - AWS Hero, juggler, and community builder. The Juggling Company brings cloud architecture, cognitive science, and the art of juggling onto the same stage."
>
  <article class="mx-auto grid max-w-5xl gap-12 px-4 py-20 md:grid-cols-[20rem_1fr] md:px-6">
    <aside>
      <div
        class="relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-1"
      >
        <img
          src="/images/IMG_9810.jpg"
          alt="Linda Mohamed"
          width="320"
          height="400"
          class="aspect-[4/5] w-full rounded-2xl object-cover"
          loading="eager"
        />
      </div>
      <dl class="mt-6 grid gap-4 text-sm">
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-muted)]">Role</dt>
          <dd class="mt-0.5 text-[var(--color-fg)]">{site.author.role}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-muted)]">Handle</dt>
          <dd class="mt-0.5 text-[var(--color-fg)]">@{site.author.handle}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-[var(--color-muted)]">Email</dt>
          <dd class="mt-0.5">
            <a class="text-[var(--color-brain-tech)] hover:underline" href={`mailto:${site.author.email}`}>{site.author.email}</a>
          </dd>
        </div>
      </dl>
      <div class="mt-6">
        <SocialLinks variant="list" />
      </div>
    </aside>

    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">About</p>
      <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
        <span class="rgb-text">{site.author.name}.</span>
      </h1>

      <div class="prose mt-8 max-w-none">
        <p class="text-lg text-[var(--color-muted)]">
          Linda Mohamed is an AWS Hero with over a decade in tech, specialising in cloud
          architecture, IT process optimisation, and agile delivery. She also juggles -
          on stage, at conferences, and as the rough metaphor for everything else she does.
        </p>
        <p>
          The Juggling Company merges those two crafts into one body of work, organised around
          three pillars that overlap like additive light: <strong style="color: var(--color-brain);">Brain</strong>,
          <strong style="color: var(--color-tech);">Tech</strong>, and
          <strong style="color: var(--color-change);">Change</strong>.
        </p>

        <h2 style="--pillar-color: var(--color-all);">Mission</h2>
        <p>
          To inspire, educate, and empower individuals through the art of juggling - fostering
          a community where juggling serves as a bridge between physical fitness, cognitive
          development, and creative expression. By integrating juggling principles with
          cutting-edge technology and innovative learning methods, we aim to promote holistic
          well-being, enhance teamwork, and drive positive change within organisations and
          individuals alike.
        </p>

        <h2 style="--pillar-color: var(--color-brain-tech);">How I work</h2>
        <ul>
          <li>
            <strong>One craft, two surfaces.</strong> Juggling and cloud both reward incremental
            load, fast feedback, and a calm response to dropped balls.
          </li>
          <li>
            <strong>Bespoke before stock.</strong> Every keynote, workshop, and performance is
            tailored to the room - no recycled decks.
          </li>
          <li>
            <strong>Evidence over vibe.</strong> The Ideas section cites the neuroscience the
            workshops draw on. The metaphor only earns its keep when the research holds.
          </li>
        </ul>

        <div
          class="not-prose relative mt-10 flex justify-center overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4"
        >
          <div
            class="absolute inset-0 -z-10"
            aria-hidden="true"
            style="background: radial-gradient(ellipse at 30% 30%, rgb(255 51 102 / 0.18), transparent 60%), radial-gradient(ellipse at 70% 30%, rgb(51 204 102 / 0.16), transparent 60%), radial-gradient(ellipse at 50% 80%, rgb(59 108 255 / 0.18), transparent 60%);"
          ></div>
          <JugglingCascade size={320} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
