---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import LocationsMap, { type MapLocation } from "@/islands/LocationsMap";
import { getLocations } from "@/lib/content";

const locations = await getLocations();

const mapLocations: MapLocation[] = locations.map((l) => ({
  slug: l.id,
  name: l.data.name,
  city: l.data.city,
  country: l.data.country,
  lat: l.data.lat,
  lng: l.data.lng,
  type: l.data.type,
  notes: l.data.notes,
  website: l.data.website,
}));

const typeLabel: Record<MapLocation["type"], string> = {
  "past-performance": "Past performance",
  "home-base": "Home base",
  available: "Available",
  workshop: "Workshop",
  "juggling-shop": "Juggling shop",
};

const typeAccent: Record<MapLocation["type"], string> = {
  "past-performance": "var(--color-brain-tech)",
  "home-base": "var(--color-brain)",
  available: "var(--color-tech)",
  workshop: "var(--color-change)",
  "juggling-shop": "var(--color-brain-change)",
};

const grouped = locations.reduce(
  (acc, l) => {
    const key = l.data.type;
    (acc[key] ??= []).push(l);
    return acc;
  },
  {} as Record<MapLocation["type"], typeof locations>,
);
---

<BaseLayout
  title="Locations"
  description="Where I've performed, where I'm based, and where I'm available next."
>
  <section class="mx-auto max-w-6xl px-4 py-20 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
      Locations
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
      <span class="rgb-text">Where I am, where I've been.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      {locations.length} {locations.length === 1 ? "location" : "locations"} on the map. Click a pin for details, or browse the list below.
    </p>
    <a
      href="/locations/juggling-shops"
      class="mt-6 inline-flex items-center gap-2 rounded-lg border border-[var(--color-brain-change)] px-4 py-2 text-sm font-medium text-[var(--color-brain-change)] transition hover:bg-[var(--color-brain-change)] hover:text-white"
    >
      <Icon name="map-pin" size={14} />
      Juggling shops directory
      <Icon name="arrow-right" size={14} />
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 md:px-6">
    <LocationsMap client:visible locations={mapLocations} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 md:px-6">
    <h2 class="font-display text-2xl font-bold tracking-tight">All locations</h2>
    <div class="mt-6 grid gap-8 md:grid-cols-2">
      {
        (Object.keys(grouped) as MapLocation["type"][]).map((type) => (
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-widest"
              style={`color: ${typeAccent[type]};`}
            >
              {typeLabel[type]} ({grouped[type].length})
            </p>
            <ul class="mt-3 flex flex-col gap-3">
              {grouped[type].map((l) => (
                <li
                  id={l.id}
                  class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4"
                  style={`border-left: 3px solid ${typeAccent[type]};`}
                >
                  <p class="font-medium text-[var(--color-fg)]">{l.data.name}</p>
                  <p class="text-sm text-[var(--color-muted)]">
                    {l.data.city}, {l.data.country}
                  </p>
                  {l.data.notes && (
                    <p class="mt-2 text-sm text-[var(--color-fg)]">{l.data.notes}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
