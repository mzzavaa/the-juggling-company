---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ShopsMap from "@/islands/ShopsMap";
import ShopDirectory from "@/islands/ShopDirectory";
import { getLocations } from "@/lib/content";

const allLocations = await getLocations();
const shops = allLocations.filter((l) => l.data.type === "juggling-shop");

// Real stats only (no ratings/review aggregates — we don't hold that data)
const physicalStores = shops.filter((s) => s.data.physicalStore).length;
const countriesCount = new Set(shops.map((s) => s.data.country)).size;
const shipsWorldwideCount = shops.filter((s) => s.data.shipsWorldwide === true).length;

// Auto-detect region from country when not explicitly set
const countryToRegion: Record<string, string> = {
  "United States": "north-america",
  "Canada": "north-america",
  "Mexico": "north-america",
  "Brazil": "south-america",
  "Argentina": "south-america",
  "Chile": "south-america",
  "Colombia": "south-america",
  "Japan": "asia",
  "China": "asia",
  "South Korea": "asia",
  "India": "asia",
  "Thailand": "asia",
  "Singapore": "asia",
  "Israel": "asia",
  "Australia": "oceania",
  "New Zealand": "oceania",
  "South Africa": "africa",
  "Egypt": "africa",
  "Morocco": "africa",
  // All other countries default to Europe
};

// Map pins
const mapShops = shops.map((s) => ({
  id: s.id,
  name: s.data.name,
  city: s.data.city,
  country: s.data.country,
  lat: s.data.lat,
  lng: s.data.lng,
  type: s.data.type as "juggling-shop",
  physicalStore: s.data.physicalStore,
  website: s.data.website,
}));

// Directory data
const directoryShops = shops.map((s) => ({
  id: s.id,
  name: s.data.name,
  slug: s.data.slug,
  lat: s.data.lat,
  lng: s.data.lng,
  country: s.data.country,
  city: s.data.city,
  notes: s.data.notes || "",
  website: s.data.website,
  address: s.data.address,
  brands: s.data.brands || [],
  categories: s.data.categories || [],
  physicalStore: s.data.physicalStore || false,
  onlineStore: s.data.onlineStore || false,
  shipsWorldwide: s.data.shipsWorldwide,
  foundedYear: s.data.foundedYear,
  isManufacturer: s.data.isManufacturer || false,
  region: s.data.region || countryToRegion[s.data.country] || "europe",
  verified: s.data.verified || false,
  lastVerified: s.data.lastVerified?.toISOString(),
  languages: s.data.languages || [],
  paymentMethods: s.data.paymentMethods || [],
  taxFree: s.data.taxFree,
  returnPolicy: s.data.returnPolicy,
  sellsCategories: s.data.sellsCategories || [],
  photos: s.data.photos || [],
  reviews: (s.data.reviews || []).map((r: any) => ({
    ...r,
    date: r.date?.toISOString() || "",
  })),
}));

// JSON-LD for SEO
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Juggling Shops Around the World",
  description: "A curated, community-maintained directory of specialist juggling and circus equipment shops worldwide.",
  numberOfItems: shops.length,
  itemListElement: shops.map((shop, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Store",
      name: shop.data.name,
      description: shop.data.notes || `Juggling shop in ${shop.data.city}, ${shop.data.country}.`,
      ...(shop.data.website ? { url: shop.data.website } : {}),
      address: {
        "@type": "PostalAddress",
        addressLocality: shop.data.city,
        addressCountry: shop.data.country,
        ...(shop.data.address ? { streetAddress: shop.data.address } : {}),
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: shop.data.lat,
        longitude: shop.data.lng,
      },
    },
  })),
};

const stats = [
  { value: shops.length, label: "Shops listed" },
  { value: countriesCount, label: "Countries" },
  { value: physicalStores, label: "Physical stores" },
  { value: shipsWorldwideCount, label: "Ship worldwide" },
];
---

<BaseLayout
  title="Find Juggling Shops Worldwide | The Juggling Company"
  description={`Discover ${shops.length} specialist juggling shops in ${countriesCount} countries. Find where to buy juggling balls, clubs, diabolos and more.`}
  jsonLd={itemListJsonLd}
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1600px] px-4 pt-8 pb-6 md:px-6 lg:px-10 md:pt-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-brain-change)]">
          Juggling Shops
        </p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
          Juggling shops around the world.
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--color-muted)]">
          A directory of juggling, circus and flow-arts shops worldwide. It's open source and
          community maintained - add a shop, suggest an edit, and help jugglers everywhere.
          To be honest about it: the only shop here I've personally visited is my local one in
          Vienna. The rest is a directory I keep to help you find gear - reviews and support from
          the community are very welcome, and I'll add my own as I visit more shops while travelling.
        </p>

        <!-- Real stats -->
        <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {stats.map((s) => (
            <div>
              <p class="font-display text-2xl font-bold text-[var(--color-brain-change)]">{s.value}</p>
              <p class="text-[10px] uppercase tracking-wider text-[var(--color-muted)]">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

      <a
        href="https://github.com/mzzavaa/the-juggling-company/issues/new?template=shop-submission.yml"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex flex-shrink-0 items-center gap-2 rounded-lg bg-[var(--color-brain-change)] px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add a shop
      </a>
    </div>

    <!-- Map -->
    <div class="mt-8">
      <ShopsMap client:visible shops={mapShops} />
    </div>
  </section>

  <!-- Directory: filters · shops · contribute -->
  <section id="directory" class="mx-auto max-w-[1600px] px-4 py-8 md:px-6 lg:px-10">
    <ShopDirectory client:load shops={directoryShops} />
  </section>
</BaseLayout>
