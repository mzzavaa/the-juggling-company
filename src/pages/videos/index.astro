---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import VideoStrip from "@/components/VideoStrip.astro";
import VideoStripCard from "@/components/VideoStripCard.astro";
import { getVideos } from "@/lib/content";

const videos = await getVideos();

// Portrait sources: TikTok and Instagram reels (9:16). Landscape: YouTube (16:9).
const portraitVideos = videos.filter(
  (v) => v.data.source === "tiktok" || v.data.source === "instagram",
);
const landscapeVideos = videos.filter((v) => v.data.source === "youtube");
---

<BaseLayout
  title="Videos"
  description="Juggling clips, conference talks, and short-form content - on YouTube, TikTok, and Instagram."
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1400px] px-4 py-20 md:px-6 lg:px-10">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Videos</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
      <span class="rgb-text">Watch the work.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      Juggling, talks, and everything in between - on YouTube, TikTok, and Instagram.
    </p>
    <p class="mt-3 text-sm text-[var(--color-muted)]">
      Hover a clip to preview. Strips drift on their own - scroll or use the arrows to take over.
    </p>
    <div class="mt-6">
      <SocialLinks />
    </div>
  </section>

  <!-- Short-form / portrait -->
  {portraitVideos.length > 0 && (
    <section class="pb-16">
      <div class="mx-auto mb-5 flex max-w-[1400px] items-end justify-between gap-4 px-4 md:px-6 lg:px-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-fg)]">
            Short clips
          </p>
          <h2 class="mt-1 font-display text-2xl font-bold tracking-tight">Reels and TikToks</h2>
        </div>
        <div class="flex shrink-0 items-center gap-4 text-sm font-semibold">
          <a
            href="https://www.tiktok.com/@mrs_lee_g_"
            class="inline-flex items-center gap-1 text-[var(--color-fg)] hover:underline"
            rel="noopener noreferrer"
            target="_blank"
          >
            TikTok <Icon name="external-link" size={14} />
          </a>
          <a
            href="https://www.instagram.com/mrs_lee_g/"
            class="inline-flex items-center gap-1 text-[#e1306c] hover:underline"
            rel="noopener noreferrer"
            target="_blank"
          >
            Instagram <Icon name="external-link" size={14} />
          </a>
        </div>
      </div>
      <VideoStrip label="Short-form video clips" speed={16}>
        {portraitVideos.map((v) => (
          <VideoStripCard video={v} orientation="portrait" />
        ))}
      </VideoStrip>
    </section>
  )}

  <!-- Long-form / landscape -->
  {landscapeVideos.length > 0 && (
    <section class="pb-24">
      <div class="mx-auto mb-5 flex max-w-[1400px] items-end justify-between gap-4 px-4 md:px-6 lg:px-10">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[#ff0033]">YouTube</p>
          <h2 class="mt-1 font-display text-2xl font-bold tracking-tight">
            Talks, podcasts, and full clips
          </h2>
        </div>
        <a
          href="https://www.youtube.com/@mrs_lee_g"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-[#ff0033] hover:underline"
          rel="noopener noreferrer"
          target="_blank"
        >
          Subscribe <Icon name="external-link" size={14} />
        </a>
      </div>
      <VideoStrip label="Long-form videos and talks" speed={20}>
        {landscapeVideos.map((v) => (
          <VideoStripCard video={v} orientation="landscape" />
        ))}
      </VideoStrip>
    </section>
  )}
</BaseLayout>
