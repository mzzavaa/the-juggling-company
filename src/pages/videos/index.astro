---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { getVideos } from "@/lib/content";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

const videos = await getVideos();

const jugglingVideos = videos.filter(
  (v) => v.data.source === "youtube" && v.data.tags.includes("juggling"),
);
const techVideos = videos.filter(
  (v) => v.data.source === "youtube" && !v.data.tags.includes("juggling"),
);
const tiktokVideos = videos.filter((v) => v.data.source === "tiktok");
const instagramVideos = videos.filter((v) => v.data.source === "instagram");
---

<BaseLayout
  title="Videos"
  description="Juggling clips, conference talks, and short-form content — on YouTube, TikTok, and Instagram."
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 py-20 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Videos</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
      <span class="rgb-text">Watch the work.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      Juggling, talks, and everything in between — on YouTube, TikTok, and Instagram.
    </p>
    <div class="mt-6">
      <SocialLinks />
    </div>
  </section>

  <!-- ── Juggling (YouTube) ─────────────────────────── -->
  {jugglingVideos.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-20 md:px-6">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-brain)]">Juggling</p>
          <h2 class="mt-1 font-display text-2xl font-bold tracking-tight">On YouTube</h2>
        </div>
        <a
          href="https://www.youtube.com/@mrs_lee_g"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-[#ff0000] hover:underline"
          rel="noopener"
          target="_blank"
        >
          Subscribe <Icon name="external-link" size={14} />
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {jugglingVideos.map((v) => {
          const accent = PILLAR_HEX[blendKey(v.data.pillars)] ?? "#9696b0";
          return (
            <div
              class="yt-card overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)]"
              style={`--card-accent: ${accent};`}
            >
              <div class="aspect-video">
                <iframe
                  src={`https://www.youtube.com/embed/${v.data.externalId}`}
                  title={v.data.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  class="h-full w-full border-0"
                />
              </div>
              <div class="p-5">
                <h3 class="font-display text-base font-semibold leading-snug text-[var(--color-fg)]">
                  {v.data.title}
                </h3>
                {v.data.description && (
                  <p class="mt-2 line-clamp-2 text-sm text-[var(--color-muted)]">
                    {v.data.description}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── TikTok grid (official embeds) ─────────────────── -->
  {tiktokVideos.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-20 md:px-6">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-fg)]">Short clips</p>
          <h2 class="mt-1 font-display text-2xl font-bold tracking-tight">TikTok</h2>
        </div>
        <a
          href="https://www.tiktok.com/@mrs_lee_g_"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-[var(--color-fg)] hover:underline"
          rel="noopener"
          target="_blank"
        >
          @mrs_lee_g_ <Icon name="external-link" size={14} />
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tiktokVideos.map((v) => (
          <div class="flex justify-center min-w-0">
            <blockquote
              class="tiktok-embed"
              cite={v.data.externalUrl}
              data-video-id={v.data.externalId}
              style="max-width:100%; min-width:0; width:100%;"
            >
              <section>
                <a href={v.data.externalUrl} target="_blank" rel="noopener noreferrer">
                  {v.data.title}
                </a>
              </section>
            </blockquote>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── Instagram grid (official embeds) ──────────────── -->
  {instagramVideos.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-20 md:px-6">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest" style="color: #e1306c;">Reels</p>
          <h2 class="mt-1 font-display text-2xl font-bold tracking-tight">Instagram</h2>
        </div>
        <a
          href="https://www.instagram.com/mrs_lee_g/"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold hover:underline"
          style="color: #e1306c;"
          rel="noopener"
          target="_blank"
        >
          @mrs_lee_g <Icon name="external-link" size={14} />
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {instagramVideos.map((v) => (
          <div class="flex justify-center min-w-0">
            <blockquote
              class="instagram-media"
              data-instgrm-permalink={v.data.externalUrl}
              data-instgrm-version="14"
              style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:0; max-width:100%; min-width:326px; width:100%;"
            >
              <div style="padding:16px;">
                <a href={v.data.externalUrl} target="_blank" rel="noopener noreferrer">
                  {v.data.title}
                </a>
              </div>
            </blockquote>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ── Creative tech (YouTube) ───────────────────── -->
  {techVideos.length > 0 && (
    <section class="pb-24">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <div class="mb-6 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-tech)]">Talks & podcasts</p>
            <h2 class="mt-1 font-display text-2xl font-bold tracking-tight">Creative tech</h2>
          </div>
          <a
            href="https://www.youtube.com/@mrs_lee_g"
            class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-[#ff0000] hover:underline"
            rel="noopener"
            target="_blank"
          >
            YouTube <Icon name="external-link" size={14} />
          </a>
        </div>
      </div>

      <div
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 md:px-6"
        style="scroll-padding-left: 1.5rem;"
        aria-label="Tech talks and podcasts"
      >
        <div class="shrink-0 w-[max(0px,calc((100vw-72rem)/2))]" aria-hidden="true"></div>

        {techVideos.map((v) => {
          const accent = PILLAR_HEX[blendKey(v.data.pillars)] ?? "#9696b0";
          return (
            <a
              href={v.data.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="tech-card snap-start flex-none w-72 overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] transition hover:-translate-y-1"
              style={`--card-accent: ${accent};`}
              aria-label={v.data.title}
            >
              <div class="aspect-video overflow-hidden">
                <img
                  src={`https://img.youtube.com/vi/${v.data.externalId}/hqdefault.jpg`}
                  alt={v.data.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition group-hover:scale-105"
                />
              </div>
              <div class="p-4">
                <p
                  class="line-clamp-2 text-sm font-semibold leading-snug text-[var(--color-fg)]"
                  style={`border-left: 2px solid ${accent}; padding-left: 8px;`}
                >
                  {v.data.title}
                </p>
                {v.data.description && (
                  <p class="mt-2 line-clamp-2 text-xs text-[var(--color-muted)]">
                    {v.data.description}
                  </p>
                )}
              </div>
            </a>
          );
        })}

        <div class="shrink-0 w-[max(1rem,calc((100vw-72rem)/2))]" aria-hidden="true"></div>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline src="https://www.tiktok.com/embed.js"></script>
<script is:inline src="https://www.instagram.com/embed.js"></script>

<style>
  .yt-card {
    transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .yt-card:hover {
    border-color: var(--card-accent);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--card-accent) 30%, transparent),
      0 12px 36px -12px color-mix(in oklab, var(--card-accent) 60%, transparent);
  }

  .tech-card {
    transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease;
  }
  .tech-card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--card-accent) 50%, transparent);
  }
</style>
