---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import VideoCard from "@/components/VideoCard.astro";
import PostCard from "@/components/PostCard.astro";
import JugglingCascade from "@/components/JugglingCascade.astro";
import { Image } from "astro:assets";
import everyoneBelongsHands from "@/assets/images/everyone-belongs-hands.png";
import worldMapGlowing from "@/assets/images/world-map-glowing.png";
import {
  getFeaturedVideos,
  getLatestPosts,
  getIdeas,
  getLocations,
} from "@/lib/content";
import { site } from "@/lib/site";
import {
  PILLARS,
  PILLAR_HEX,
  PILLAR_LABEL,
  PILLAR_FULL_LABEL,
  type Pillar,
} from "@/lib/pillar";

const [featuredVideos, latestPosts, ideas, locations] = await Promise.all([
  getFeaturedVideos(3),
  getLatestPosts(2),
  getIdeas(),
  getLocations(),
]);

const pillarIcons: Record<Pillar, "brain" | "cpu" | "shuffle"> = {
  brain: "brain",
  tech: "cpu",
  change: "shuffle",
};

const pillarSummaries: Record<Pillar, string> = {
  brain:
    "What juggling does to grey matter, focus, and the way humans learn - backed by peer-reviewed neuroscience, not folklore.",
  tech:
    "Cloud architecture, AWS systems, and AI patterns - read through a juggler's lens of incremental load, graceful recovery, and knowing when to add a fourth ball.",
  change:
    "How teams absorb new work, recover from drops, and build the muscle memory to stay stable under pressure. A ball in someone's hand is more honest than an iceberg diagram.",
};

const ideasByPillar = (p: Pillar) => ideas.find((i) => i.data.pillars.includes(p));


const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author.name,
  jobTitle: site.author.role,
  url: site.url,
  image: new URL(site.defaultOgImage, site.url).toString(),
  description: site.description,
  sameAs: [
    "https://www.youtube.com/@mrs_lee_g",
    "https://www.instagram.com/mrs_lee_g/",
    "https://x.com/linda_mhmd",
    "https://github.com/linda_mhmd",
    "https://aws.amazon.com/developer/community/heroes/linda-mohamed/",
  ],
};
---

<BaseLayout jsonLd={personJsonLd}>
  <!-- HERO -->
  <section class="hero relative overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="blob-brain absolute -left-32 top-0 h-[28rem] w-[28rem] rounded-full opacity-40 blur-3xl"
        style="background: var(--color-brain);"
      ></div>
      <div
        class="blob-tech absolute right-0 top-32 h-[26rem] w-[26rem] rounded-full opacity-35 blur-3xl"
        style="background: var(--color-tech);"
      ></div>
      <div
        class="blob-change absolute bottom-0 left-1/3 h-[30rem] w-[30rem] rounded-full opacity-40 blur-3xl"
        style="background: var(--color-change);"
      ></div>
    </div>

    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:py-20 md:px-6 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/80 px-3 py-1 text-xs font-medium uppercase tracking-widest text-[var(--color-fg)] backdrop-blur"
        >
          <span class="inline-block h-2 w-2 rounded-full" style="background: var(--color-brain);"></span>
          <span class="inline-block h-2 w-2 rounded-full" style="background: var(--color-tech);"></span>
          <span class="inline-block h-2 w-2 rounded-full" style="background: var(--color-change);"></span>
          AWS Hero · Juggler · Vienna
        </p>

        <h1 class="mt-6 font-display text-[clamp(3rem,8vw,6rem)] font-bold leading-[0.95] tracking-tight">
          <span class="block" style="color: var(--color-brain);">Brain.</span>
          <span class="block ml-[5%]" style="color: var(--color-tech);">Tech.</span>
          <span class="block ml-[10%]" style="color: var(--color-change);">Change.</span>
        </h1>

        <p class="mt-8 max-w-md text-lg leading-relaxed text-[var(--color-fg)] md:text-xl">
          Juggling has no prerequisites. <strong>{site.author.name}</strong> - AWS Hero, keynote speaker, and juggler - explores what happens when you stop choosing between the technical and the human, and keep everything moving at once.
        </p>

        <p class="mt-4 max-w-md text-base leading-relaxed text-[var(--color-muted)]">
          On stage from Las Vegas to Istanbul. In workshops, in conference rooms, and on the road - bringing the pattern that connects brain science, cloud systems, and the courage to change.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/ideas"
            class="group inline-flex items-center gap-2 rounded-full px-6 py-3.5 font-semibold text-[var(--color-bg)] shadow-xl transition hover:shadow-2xl"
            style="background: linear-gradient(100deg, var(--color-brain), var(--color-brain-tech), var(--color-tech), var(--color-tech-change), var(--color-change)); background-size: 220% auto;"
          >
            Why juggle?
            <Icon name="arrow-right" size={18} />
          </a>
          <a
            href={`mailto:${site.author.email}`}
            class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg-elevated)] px-6 py-3.5 font-medium text-[var(--color-fg)] transition hover:border-[var(--color-brain-tech)] hover:text-[var(--color-brain-tech)]"
          >
            <Icon name="mail" size={16} />
            Work with me
          </a>
        </div>
      </div>

      <div class="hidden md:flex md:items-center md:justify-center">
        <JugglingCascade size={460} />
      </div>
    </div>
  </section>


  <!-- NO PREREQUISITES: the mission -->
  <section class="mx-auto max-w-7xl px-4 py-24 md:px-6">
    <div class="grid gap-14 md:grid-cols-[1.1fr_1fr] md:items-start">

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">The one thing juggling has that most skills don't</p>
        <h2 class="mt-3 font-display text-4xl font-bold tracking-tight md:text-5xl">
          No prerequisites.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-[var(--color-muted)]">
          Basketball rewards height. Ballet has historically demanded a specific body type. Team sports need coordination with others. Distance running punishes old injuries. Swimming requires access to water. Almost every skill you might want to learn comes with a gatekeeping requirement - real or assumed - standing in front of it.
        </p>
        <p class="mt-4 leading-relaxed text-[var(--color-muted)]">
          Juggling has none of these. You can juggle short or tall, young or old, with your hands, your feet, or a headband. Sitting in a wheelchair. After surgery. At eight or at eighty. The pattern works the same for everyone, because the only requirement is that you try.
        </p>
        <p class="mt-4 leading-relaxed text-[var(--color-muted)]">
          It's been used with orphaned children to teach them what success feels like for the first time. With refugees building resilience after trauma. With older adults - 50s, 60s, 70s - who assumed that their brains had stopped growing. All of them were wrong about what they were capable of.
        </p>

        <div
          class="mt-8 rounded-2xl border border-[var(--color-border)] p-6"
          style="background: color-mix(in oklab, var(--color-brain) 6%, var(--color-bg-card));"
        >
          <p class="text-xl font-semibold leading-snug text-[var(--color-fg)] md:text-2xl">
            "When you juggle, you are enough."
          </p>
          <p class="mt-3 text-sm text-[var(--color-muted)]">
            Not because you've met a standard. Because juggling has no standard to meet.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/ideas"
            class="inline-flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition hover:opacity-90"
            style="background: var(--color-brain-tech); color: #0a0a12;"
          >
            <Icon name="arrow-right" size={14} />
            Read the full case
          </a>
          <a
            href="/locations/juggling-shops"
            class="inline-flex items-center gap-2 rounded-xl border border-[var(--color-border)] px-5 py-3 text-sm font-semibold text-[var(--color-fg)] transition hover:bg-[var(--color-bg-elevated)]"
          >
            Find a shop near you
          </a>
        </div>

        <Image
          src={everyoneBelongsHands}
          alt="A child's hand, an elderly hand, and a hand beside a wheelchair wheel - each holding a glowing ball"
          width={700}
          height={394}
          class="mt-6 w-full rounded-2xl object-cover"
          loading="lazy"
        />
      </div>

      <!-- Research cards -->
      <div class="flex flex-col gap-4">
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6" style="border-top: 3px solid var(--color-brain);">
          <p class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-brain);">Grey matter grows</p>
          <p class="mt-2 leading-relaxed text-[var(--color-fg)]">
            Three months of juggling produces measurable grey matter growth in visual and motor areas of the brain. The effect holds even in adults aged 50–67 - regions thought to be fixed.
          </p>
          <p class="mt-3 text-xs text-[var(--color-muted)]">
            Draganski et al., <em>Nature</em>, 2004 · Boyke et al., <em>Journal of Neuroscience</em>, 2008
          </p>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6" style="border-top: 3px solid var(--color-change);">
          <p class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-change-text);">Anxiety and depression</p>
          <p class="mt-2 leading-relaxed text-[var(--color-fg)]">
            Regular juggling practice significantly reduces anxiety and depression scores. Studies on medical students during high-stress exam periods found measurable improvements after only weeks of practice.
          </p>
          <p class="mt-3 text-xs text-[var(--color-muted)]">
            Nakahara et al., <em>BioPsychoSocial Medicine</em>, 2007 · Zainaldeen et al., 2018
          </p>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6" style="border-top: 3px solid var(--color-tech);">
          <p class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-tech);">Reaction time</p>
          <p class="mt-2 leading-relaxed text-[var(--color-fg)]">
            Juggling training improves reaction time by 20–25%. These reflexes aren't abstract - they transfer directly to daily life. Something tips over on a shelf, and your hands are already there.
          </p>
          <p class="mt-3 text-xs text-[var(--color-muted)]">
            Malik et al., <em>International Journal of Environmental Research and Public Health</em>, 2022 (systematic review)
          </p>
        </div>

        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6" style="border-top: 3px solid var(--color-brain-change);">
          <p class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-brain-change);">Community and resilience</p>
          <p class="mt-2 leading-relaxed text-[var(--color-fg)]">
            Circus and juggling programs have been shown to build resilience and a sense of belonging in at-risk youth and displaced communities - not as therapy, but as shared practice.
          </p>
          <p class="mt-3 text-xs text-[var(--color-muted)]">
            Fournier et al., <em>Canadian Family Physician</em>, 2014 · Van Es et al., <em>Journal of Refugee Studies</em>, 2019
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE PILLARS -->
  <section class="mx-auto max-w-7xl px-4 py-24 md:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
          Three pillars
        </p>
        <h2 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-5xl">
          The work lives at the<br /><span class="rgb-text">overlap.</span>
        </h2>
      </div>
      <p class="max-w-md text-[var(--color-muted)]">
        Like additive light - each pillar has its own colour. The most interesting work happens where two or three combine. That's where the juggling happens.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        PILLARS.map((p, i) => {
          const idea = ideasByPillar(p);
          const offset = i === 0 ? "" : i === 1 ? "md:translate-y-6" : "md:translate-y-12";
          return (
            <li class={offset}>
              <a
                href={idea ? `/ideas/${idea.id}` : "/ideas"}
                class="pillar-card group flex h-full flex-col gap-5 rounded-3xl border-2 p-7 transition"
                data-pillar={p}
                style={`border-color: ${PILLAR_HEX[p]}55; background: linear-gradient(145deg, color-mix(in oklab, ${PILLAR_HEX[p]} 14%, var(--color-bg-card)), var(--color-bg-card)); --pillar-color: ${PILLAR_HEX[p]}; --pillar-glow: 0 0 0 2px ${PILLAR_HEX[p]}, 0 24px 64px -16px ${PILLAR_HEX[p]}aa;`}
              >
                <span
                  class="inline-flex h-14 w-14 items-center justify-center rounded-2xl"
                  style={`background: ${PILLAR_HEX[p]}; color: #0a0a12;`}
                >
                  <Icon name={pillarIcons[p]} size={28} />
                </span>
                <div>
                  <p
                    class="text-xs font-bold uppercase tracking-widest"
                    style={`color: ${PILLAR_HEX[p]};`}
                  >
                    {PILLAR_LABEL[p]}
                  </p>
                  <h3 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-[var(--color-fg)]">
                    {PILLAR_FULL_LABEL[p].replace("Juggling and ", "").replace("Your ", "")}
                  </h3>
                </div>
                <p class="text-[var(--color-muted)]">{pillarSummaries[p]}</p>
                {idea && (
                  <span
                    class="mt-auto inline-flex items-center gap-1 text-sm font-semibold"
                    style={`color: ${PILLAR_HEX[p]};`}
                  >
                    Read the essay <Icon name="arrow-right" size={14} />
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    featuredVideos.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
              Watch
            </p>
            <h2 class="mt-1 font-display text-4xl font-bold tracking-tight">From the channel</h2>
          </div>
          <a
            href="/videos"
            class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-brain-tech)] hover:underline"
          >
            All videos <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <ul class="grid gap-6 md:grid-cols-3">
          {featuredVideos.map((v) => (
            <li>
              <VideoCard video={v} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    latestPosts.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
              From the blog
            </p>
            <h2 class="mt-1 font-display text-4xl font-bold tracking-tight">From the road</h2>
          </div>
          <a
            href="/blog"
            class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-brain-tech)] hover:underline"
          >
            All posts <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <ul class="grid gap-6 md:grid-cols-2">
          {latestPosts.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- LOCATIONS CTA -->
  <section class="mx-auto max-w-7xl px-4 py-20 md:px-6">
    <div
      class="locations-cta relative overflow-hidden rounded-3xl border-2 border-[var(--color-tech-change)] bg-[var(--color-bg-card)] p-1"
    >
      <div class="grid gap-0 md:grid-cols-2">
        <div class="p-8 md:p-12">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-tech-change)]">
            Where I am
          </p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight">
            Past stages,<br />future dates.
          </h2>
          <p class="mt-3 max-w-md text-[var(--color-muted)]">
            <span class="font-semibold text-[var(--color-fg)]">{locations.length}</span>{" "}
            {locations.length === 1 ? "location" : "locations"} on the map - performances, workshops, and places where the work has landed.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/locations"
              class="inline-flex items-center gap-2 rounded-full bg-[var(--color-tech-change)] px-5 py-3 font-semibold text-[var(--color-bg)] transition hover:opacity-90"
            >
              <Icon name="map-pin" size={16} />
              Open the map
            </a>
            <a
              href="/locations/juggling-shops"
              class="inline-flex items-center gap-2 rounded-full border border-[var(--color-tech-change)] px-5 py-3 text-sm font-medium text-[var(--color-tech-change)] transition hover:bg-[var(--color-tech-change)] hover:text-[var(--color-bg)]"
            >
              Find juggling shops
            </a>
          </div>
        </div>
        <div class="relative min-h-[280px] overflow-hidden">
          <Image
            src={worldMapGlowing}
            alt="World map with glowing dots marking juggling locations"
            width={700}
            height={400}
            class="h-full w-full object-cover opacity-90"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-card:hover {
    box-shadow: var(--pillar-glow);
    transform: translateY(-4px);
  }
  .pillar-card {
    transition: box-shadow 220ms ease, transform 220ms ease;
  }
</style>
