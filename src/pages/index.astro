---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import VideoCard from "@/components/VideoCard.astro";
import PostCard from "@/components/PostCard.astro";
import RGBHero from "@/components/RGBHero.astro";
import {
  getFeaturedVideos,
  getLatestPosts,
  getIdeas,
  getLocations,
} from "@/lib/content";
import { site } from "@/lib/site";
import {
  PILLARS,
  PILLAR_HEX,
  PILLAR_LABEL,
  PILLAR_FULL_LABEL,
  type Pillar,
} from "@/lib/pillar";

const [featuredVideos, latestPosts, ideas, locations] = await Promise.all([
  getFeaturedVideos(3),
  getLatestPosts(2),
  getIdeas(),
  getLocations(),
]);

const pillarIcons: Record<Pillar, "brain" | "cpu" | "shuffle"> = {
  brain: "brain",
  tech: "cpu",
  change: "shuffle",
};

const pillarSummaries: Record<Pillar, string> = {
  brain:
    "What juggling does to grey matter, focus, and the way we learn — backed by neuroscience, not folklore.",
  tech:
    "Cloud architecture, AWS systems, and AI patterns — read through a juggler's lens of incremental load and recovery.",
  change:
    "How teams absorb new work, recover from drops, and build the muscle to add a fourth ball.",
};

const ideasByPillar = (p: Pillar) => ideas.find((i) => i.data.pillars.includes(p));

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author.name,
  jobTitle: site.author.role,
  url: site.url,
  image: new URL(site.defaultOgImage, site.url).toString(),
  description: site.description,
  sameAs: [
    "https://www.youtube.com/@mrs_lee_g",
    "https://www.instagram.com/mrs_lee_g/",
    "https://x.com/mrs_lee_g",
    "https://aws.amazon.com/developer/community/heroes/linda-mohamed/",
  ],
};
---

<BaseLayout jsonLd={personJsonLd}>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="blob-brain absolute -left-32 top-0 h-[28rem] w-[28rem] rounded-full opacity-30 blur-3xl"
        style="background: var(--color-brain);"
      ></div>
      <div
        class="blob-tech absolute right-0 top-20 h-[24rem] w-[24rem] rounded-full opacity-30 blur-3xl"
        style="background: var(--color-tech);"
      ></div>
      <div
        class="blob-change absolute bottom-0 left-1/3 h-[28rem] w-[28rem] rounded-full opacity-30 blur-3xl"
        style="background: var(--color-change);"
      ></div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:py-28 md:px-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-elevated)]/70 px-3 py-1 text-xs font-medium uppercase tracking-widest text-[var(--color-muted)] backdrop-blur">
          <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--color-brain);"></span>
          <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--color-tech);"></span>
          <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--color-change);"></span>
          AWS Hero · Juggler · @mrs_lee_g
        </p>

        <h1 class="mt-6 font-display text-5xl font-bold leading-[1.02] tracking-tight md:text-7xl">
          <span style="color: var(--color-brain);">Brain.</span>
          <span style="color: var(--color-tech);">Tech.</span>
          <span style="color: var(--color-change);">Change.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg text-[var(--color-muted)] md:text-xl">
          Three pillars, mixing like light. {site.author.name} on the patterns underneath cloud systems, cognitive science, and leading change — taught from a stage with three balls in the air.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/ideas"
            class="group inline-flex items-center gap-2 rounded-full px-5 py-3 font-semibold text-[var(--color-bg)] shadow-lg transition hover:shadow-xl"
            style="background: linear-gradient(100deg, var(--color-brain), var(--color-brain-change), var(--color-change), var(--color-tech-change), var(--color-tech)); background-size: 200% auto;"
          >
            Read the Ideas
            <Icon name="arrow-right" size={16} />
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg-elevated)] px-5 py-3 font-medium text-[var(--color-fg)] transition hover:border-[var(--color-brain-tech)] hover:text-[var(--color-brain-tech)]"
          >
            <Icon name="mail" size={16} />
            Book me for an event
          </a>
        </div>
      </div>

      <div class="hidden justify-center lg:flex">
        <RGBHero size={420} />
      </div>
    </div>
  </section>

  <!-- Three pillar cards -->
  <section class="mx-auto max-w-6xl px-4 py-20 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
      Three pillars
    </p>
    <h2 class="mt-2 font-display text-3xl font-bold tracking-tight md:text-4xl">
      The work lives at the overlap.
    </h2>
    <p class="mt-3 max-w-2xl text-[var(--color-muted)]">
      Like additive light: each pillar is its own colour, but the most interesting work happens
      where two or three combine.
    </p>

    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {
        PILLARS.map((p) => {
          const idea = ideasByPillar(p);
          return (
            <li>
              <a
                href={idea ? `/ideas/${idea.id}` : "/ideas"}
                class="pillar-card group flex h-full flex-col gap-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-7 transition"
                data-pillar={p}
                style={`--pillar-color: ${PILLAR_HEX[p]}; --pillar-glow: 0 0 0 1px ${PILLAR_HEX[p]}55, 0 16px 48px -16px ${PILLAR_HEX[p]}99;`}
              >
                <span
                  class="inline-flex h-12 w-12 items-center justify-center rounded-xl"
                  style={`background: color-mix(in oklab, ${PILLAR_HEX[p]} 18%, transparent); color: ${PILLAR_HEX[p]};`}
                >
                  <Icon name={pillarIcons[p]} size={24} />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest" style={`color: ${PILLAR_HEX[p]};`}>
                    {PILLAR_LABEL[p]}
                  </p>
                  <h3 class="mt-1 font-display text-2xl font-bold tracking-tight text-[var(--color-fg)]">
                    {PILLAR_FULL_LABEL[p].replace("Juggling and ", "").replace("Your ", "")}
                  </h3>
                </div>
                <p class="text-sm text-[var(--color-muted)]">{pillarSummaries[p]}</p>
                {idea && (
                  <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium" style={`color: ${PILLAR_HEX[p]};`}>
                    Read the essay <Icon name="arrow-right" size={14} />
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    featuredVideos.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
              Latest videos
            </p>
            <h2 class="mt-1 font-display text-3xl font-bold tracking-tight">From the channel</h2>
          </div>
          <a
            href="/videos"
            class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-brain-tech)] hover:underline"
          >
            All videos <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <ul class="grid gap-6 md:grid-cols-3">
          {featuredVideos.map((v) => (
            <li>
              <VideoCard video={v} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    latestPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
              From the blog
            </p>
            <h2 class="mt-1 font-display text-3xl font-bold tracking-tight">Read</h2>
          </div>
          <a
            href="/blog"
            class="inline-flex items-center gap-1 text-sm font-medium text-[var(--color-brain-tech)] hover:underline"
          >
            All posts <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <ul class="grid gap-6 md:grid-cols-2">
          {latestPosts.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-4 py-20 md:px-6">
    <div class="overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-bg-card)]">
      <div class="grid gap-0 md:grid-cols-2">
        <div class="p-8 md:p-12">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-tech-change)]">
            Where I am
          </p>
          <h2 class="mt-2 font-display text-3xl font-bold tracking-tight">
            Past stages, future dates.
          </h2>
          <p class="mt-3 max-w-md text-[var(--color-muted)]">
            {locations.length} {locations.length === 1 ? "location" : "locations"} on the map — performances I've done and places I'm available next.
          </p>
          <a
            href="/locations"
            class="mt-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-tech-change)] px-5 py-3 font-medium text-[var(--color-tech-change)] transition hover:bg-[var(--color-tech-change)] hover:text-[var(--color-bg)]"
          >
            <Icon name="map-pin" size={16} />
            Open the map
          </a>
        </div>
        <div class="relative flex min-h-[240px] items-center justify-center overflow-hidden">
          <div
            class="absolute inset-0"
            style="background: radial-gradient(ellipse at center, rgb(51 204 255 / 0.25), transparent 60%), radial-gradient(ellipse at 30% 70%, rgb(204 51 255 / 0.18), transparent 60%);"
          ></div>
          <Icon name="map-pin" size={120} class="relative text-[var(--color-tech-change)] opacity-80" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pillar-card:hover {
    box-shadow: var(--pillar-glow);
    border-color: var(--pillar-color);
    transform: translateY(-2px);
  }
  .pillar-card {
    transition: box-shadow 220ms ease, transform 220ms ease, border-color 220ms ease;
  }
</style>
