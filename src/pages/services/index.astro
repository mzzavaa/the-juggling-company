---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { getServices } from "@/lib/content";

const services = await getServices();

const priceLabel: Record<string, string> = {
  inquire: "On request",
  fixed: "Fixed fee",
  tiered: "Tiered pricing",
};
---

<BaseLayout
  title="Services"
  description="Performances, workshops, keynotes, and idea talks — bookable formats for events, teams, and conferences."
>
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Services</p>
    <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight md:text-5xl">
      Ways to work together.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted)]">
      Four bookable formats — pick the one that fits your room. Custom packages combining
      formats are available too; just say what you need.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 md:px-6">
    <ul class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <li>
            <a
              href={`/services/${s.id}`}
              class="group flex h-full flex-col gap-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-8 transition hover:border-[var(--color-accent)]"
            >
              <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">
                {priceLabel[s.data.priceModel]}
              </p>
              <h2 class="font-display text-2xl font-semibold tracking-tight text-[var(--color-fg)] group-hover:text-[var(--color-accent)]">
                {s.data.title}
              </h2>
              <p class="text-[var(--color-muted)]">{s.data.summary}</p>
              <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)]">
                Details <Icon name="arrow-right" size={14} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
