---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { getServices } from "@/lib/content";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((s, i) => ({
    params: { slug: s.id },
    props: { service: s, accentIdx: i },
  }));
}

const { service, accentIdx } = Astro.props;

const accents = [
  "var(--color-brain)",
  "var(--color-tech)",
  "var(--color-change)",
  "var(--color-brain-tech)",
];
const accent = accents[(accentIdx as number) % accents.length];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.data.title,
  description: service.data.summary,
  audience: { "@type": "Audience", audienceType: service.data.audience },
  provider: { "@type": "Person", name: "Linda Mohamed" },
};
---

<BaseLayout
  title={service.data.title}
  description={service.data.summary}
  jsonLd={serviceJsonLd}
>
  <div class="service-stripe" style={`background: ${accent};`} aria-hidden="true"></div>

  <article class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
      <a href="/services" class="hover:text-[var(--color-fg)]">Services</a>
    </p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-5xl">{service.data.title}</h1>
    <p class="mt-4 text-lg text-[var(--color-muted)]">{service.data.summary}</p>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-lg font-bold tracking-tight" style={`color: ${accent};`}>Audience</h2>
        <p class="mt-2 text-[var(--color-fg)]">{service.data.audience}</p>
      </div>
      <div>
        <h2 class="font-display text-lg font-bold tracking-tight" style={`color: ${accent};`}>Formats</h2>
        <ul class="mt-2 flex flex-col gap-1.5">
          {
            service.data.formats.map((f) => (
              <li class="flex items-start gap-2 text-[var(--color-fg)]">
                <span class="mt-1" style={`color: ${accent};`}>
                  <Icon name="circle-check" size={14} />
                </span>
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-lg font-bold tracking-tight" style={`color: ${accent};`}>What's included</h2>
      <ul class="mt-3 flex flex-col gap-2">
        {
          service.data.whatsIncluded.map((item) => (
            <li class="flex items-start gap-2 text-[var(--color-fg)]">
              <span class="mt-1" style={`color: ${accent};`}>
                <Icon name="circle-check" size={16} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12">
      <a
        href={service.data.ctaUrl}
        class="inline-flex items-center gap-2 rounded-full px-5 py-3 font-semibold text-[var(--color-bg)] shadow-lg transition"
        style={`background: ${accent};`}
      >
        Get in touch <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .service-stripe { height: 4px; width: 100%; }
</style>
