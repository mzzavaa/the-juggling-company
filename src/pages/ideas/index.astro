---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PillarBadge from "@/components/PillarBadge.astro";
import { formatDate } from "@/lib/format";
import { getIdeas } from "@/lib/content";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";

const ideas = await getIdeas();
---

<BaseLayout
  title="Ideas"
  description="Long-form essays at the intersection of juggling, neuroscience, cloud, and how teams adapt to change."
>
  <section class="mx-auto max-w-4xl px-4 py-20 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Ideas</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
      <span class="rgb-text">Essays from the practice.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      Slow-cooked pieces on what juggling teaches about cognition, cloud systems, and how
      humans absorb change.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 md:px-6">
    <ul class="flex flex-col gap-6">
      {
        ideas.map((idea) => {
          const accentHex = PILLAR_HEX[blendKey(idea.data.pillars)];
          return (
            <li>
              <a
                href={`/ideas/${idea.id}`}
                class="card group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 transition md:p-8"
                style={`--card-accent: ${accentHex};`}
              >
                <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                  <span>Updated {formatDate(idea.data.updatedAt)}</span>
                  <PillarBadge pillars={idea.data.pillars} variant="solid" />
                </div>
                <h2 class="mt-4 font-display text-2xl font-bold tracking-tight text-[var(--color-fg)] md:text-3xl">
                  {idea.data.title}
                </h2>
                <p class="mt-3 max-w-2xl text-[var(--color-muted)]">{idea.data.summary}</p>
                <span
                  class="mt-5 inline-flex items-center gap-1 text-sm font-semibold"
                  style={`color: ${accentHex};`}
                >
                  Read essay <Icon name="arrow-right" size={14} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .card { transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease; }
  .card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-accent) 30%, transparent),
      0 16px 48px -16px color-mix(in oklab, var(--card-accent) 60%, transparent);
    transform: translateY(-2px);
  }
</style>
