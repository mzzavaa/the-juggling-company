---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { formatDate } from "@/lib/format";
import { getIdeas } from "@/lib/content";

const ideas = await getIdeas();
---

<BaseLayout
  title="Ideas"
  description="Long-form essays at the intersection of juggling, neuroscience, and how teams adapt to change."
>
  <section class="mx-auto max-w-4xl px-4 py-16 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Ideas</p>
    <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight md:text-5xl">
      Essays from the practice.
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted)]">
      Slow-cooked pieces on what juggling teaches about cognition, change, and how
      systems behave under load.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 md:px-6">
    <ul class="flex flex-col gap-6">
      {
        ideas.map((idea) => (
          <li>
            <a
              href={`/ideas/${idea.id}`}
              class="group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 transition hover:border-[var(--color-accent)] md:p-8"
            >
              <div class="flex items-center gap-3 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                <span>Updated {formatDate(idea.data.updatedAt)}</span>
                {idea.data.tags.length > 0 && (
                  <span class="flex flex-wrap items-center gap-1">
                    {idea.data.tags.map((t) => (
                      <span class="rounded-full bg-[var(--color-bg)] px-2 py-0.5">#{t}</span>
                    ))}
                  </span>
                )}
              </div>
              <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-[var(--color-fg)] group-hover:text-[var(--color-accent)] md:text-3xl">
                {idea.data.title}
              </h2>
              <p class="mt-3 max-w-2xl text-[var(--color-muted)]">{idea.data.summary}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)]">
                Read essay <Icon name="arrow-right" size={14} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
