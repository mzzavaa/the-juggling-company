---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PillarBadge from "@/components/PillarBadge.astro";
import VideoCard from "@/components/VideoCard.astro";
import { formatDate, readingTimeMinutes } from "@/lib/format";
import { getIdeas, getVideos } from "@/lib/content";
import { blendKey, PILLAR_HEX, PILLAR_LABEL_KEYED } from "@/lib/pillar";

export async function getStaticPaths() {
  const ideas = await getIdeas();
  return ideas.map((idea) => ({
    params: { slug: idea.id },
    props: { idea },
  }));
}

const { idea } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(idea);

const ideas = await getIdeas();
const idx = ideas.findIndex((i) => i.id === idea.id);
const prev = idx > 0 ? ideas[idx - 1] : null;
const next = idx < ideas.length - 1 ? ideas[idx + 1] : null;

const allVideos = await getVideos();
const relatedVideos = allVideos.filter((v) =>
  v.data.ideaSlugs.some((ref) => ref.id === idea.id),
);

const readingMinutes = readingTimeMinutes(
  (remarkPluginFrontmatter as { rawText?: string }).rawText ?? idea.body ?? "",
);

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const pKey = blendKey(idea.data.pillars);
const accentHex = PILLAR_HEX[pKey];
const pLabel = PILLAR_LABEL_KEYED[pKey];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: idea.data.title,
  description: idea.data.summary,
  datePublished: idea.data.updatedAt.toISOString(),
  dateModified: idea.data.updatedAt.toISOString(),
  author: { "@type": "Person", name: "Linda Mohamed" },
};
---

<BaseLayout
  title={idea.data.title}
  description={idea.data.summary}
  type="article"
  publishedAt={idea.data.updatedAt}
  jsonLd={articleJsonLd}
>
  <!-- Big pillar-coloured hero band -->
  <header
    class="essay-hero relative overflow-hidden"
    style={`--accent: ${accentHex};`}
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div
        class="absolute -left-20 top-0 h-[24rem] w-[24rem] rounded-full opacity-50 blur-3xl"
        style={`background: ${accentHex};`}
      ></div>
      <div
        class="absolute -right-20 bottom-0 h-[20rem] w-[20rem] rounded-full opacity-30 blur-3xl"
        style={`background: ${accentHex};`}
      ></div>
    </div>
    <div class="mx-auto max-w-4xl px-4 py-16 md:py-20 md:px-6">
      <p class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-widest">
        <a
          href="/ideas"
          class="text-[var(--color-muted)] transition hover:text-[var(--color-fg)]"
        >
          Ideas
        </a>
        <span class="text-[var(--color-muted)]">·</span>
        <span style={`color: ${accentHex};`}>{pLabel}</span>
        <span class="text-[var(--color-muted)]">·</span>
        <span class="text-[var(--color-muted)]">{readingMinutes} min read</span>
        <span class="text-[var(--color-muted)]">·</span>
        <span class="text-[var(--color-muted)]">Updated {formatDate(idea.data.updatedAt)}</span>
      </p>
      <h1
        class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight md:text-6xl"
      >
        {idea.data.title}
      </h1>
      <p class="mt-6 max-w-2xl text-xl text-[var(--color-fg)]">{idea.data.summary}</p>
      <div class="mt-6">
        <PillarBadge pillars={idea.data.pillars} variant="solid" size="md" />
      </div>
    </div>
  </header>

  <article
    class="mx-auto grid max-w-7xl gap-12 px-4 py-12 md:px-6 lg:grid-cols-[1fr_18rem]"
    data-pillar={pKey}
  >
    <div class="prose">
      <Content />

      {
        relatedVideos.length > 0 && (
          <section class="not-prose mt-12">
            <h2 class="font-display text-2xl font-bold tracking-tight">Related videos</h2>
            <ul class="mt-6 grid gap-6 md:grid-cols-2">
              {relatedVideos.map((v) => (
                <li>
                  <VideoCard video={v} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <nav
        class="not-prose mt-12 grid gap-4 border-t border-[var(--color-border)] pt-8 md:grid-cols-2"
        aria-label="Essay pagination"
      >
        {
          prev ? (
            <a
              href={`/ideas/${prev.id}`}
              class="group rounded-xl border border-[var(--color-border)] p-4 transition hover:border-[var(--color-fg)]"
            >
              <span class="flex items-center gap-1 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                <Icon name="chevron-left" size={12} /> Previous
              </span>
              <span class="mt-1 block font-medium">{prev.data.title}</span>
            </a>
          ) : (
            <div />
          )
        }
        {
          next && (
            <a
              href={`/ideas/${next.id}`}
              class="group rounded-xl border border-[var(--color-border)] p-4 text-right transition hover:border-[var(--color-fg)]"
            >
              <span class="flex items-center justify-end gap-1 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                Next <Icon name="chevron-right" size={12} />
              </span>
              <span class="mt-1 block font-medium">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>

    {
      tocHeadings.length > 0 && (
        <aside class="hidden lg:block">
          <div
            class="sticky top-24 rounded-xl border-2 bg-[var(--color-bg-elevated)] p-5"
            style={`border-color: ${accentHex}55;`}
          >
            <p
              class="text-xs font-bold uppercase tracking-widest"
              style={`color: ${accentHex};`}
            >
              On this page
            </p>
            <ol class="mt-3 flex flex-col gap-2 text-sm">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? "pl-4" : ""}>
                  <a
                    href={`#${h.slug}`}
                    class="text-[var(--color-muted)] transition hover:text-[var(--color-fg)]"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .essay-hero {
    border-bottom: 4px solid var(--accent);
  }
</style>
