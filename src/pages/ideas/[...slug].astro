---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import VideoCard from "@/components/VideoCard.astro";
import { formatDate, readingTimeMinutes } from "@/lib/format";
import { getIdeas, getVideos } from "@/lib/content";

export async function getStaticPaths() {
  const ideas = await getIdeas();
  return ideas.map((idea) => ({
    params: { slug: idea.id },
    props: { idea },
  }));
}

const { idea } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(idea);

const ideas = await getIdeas();
const idx = ideas.findIndex((i) => i.id === idea.id);
const prev = idx > 0 ? ideas[idx - 1] : null;
const next = idx < ideas.length - 1 ? ideas[idx + 1] : null;

const allVideos = await getVideos();
const relatedVideos = allVideos.filter((v) =>
  v.data.ideaSlugs.some((ref) => ref.id === idea.id),
);

const readingMinutes = readingTimeMinutes(
  (remarkPluginFrontmatter as { rawText?: string }).rawText ?? idea.body ?? "",
);

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: idea.data.title,
  description: idea.data.summary,
  datePublished: idea.data.updatedAt.toISOString(),
  dateModified: idea.data.updatedAt.toISOString(),
  author: { "@type": "Person", name: "Linda Mohamed" },
};
---

<BaseLayout
  title={idea.data.title}
  description={idea.data.summary}
  type="article"
  publishedAt={idea.data.updatedAt}
  jsonLd={articleJsonLd}
>
  <article class="mx-auto grid max-w-6xl gap-12 px-4 py-12 md:px-6 lg:grid-cols-[1fr_18rem]">
    <div class="prose">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
        <a href="/ideas" class="hover:text-[var(--color-accent)]">Ideas</a> · {readingMinutes} min read · Updated {formatDate(idea.data.updatedAt)}
      </p>
      <h1>{idea.data.title}</h1>
      <p class="text-lg text-[var(--color-muted)]">{idea.data.summary}</p>
      <hr />
      <Content />

      {
        relatedVideos.length > 0 && (
          <section class="not-prose mt-12">
            <h2 class="font-display text-2xl font-semibold tracking-tight">Related videos</h2>
            <ul class="mt-6 grid gap-6 md:grid-cols-2">
              {relatedVideos.map((v) => (
                <li>
                  <VideoCard video={v} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <nav
        class="not-prose mt-12 grid gap-4 border-t border-[var(--color-border)] pt-8 md:grid-cols-2"
        aria-label="Essay pagination"
      >
        {
          prev ? (
            <a
              href={`/ideas/${prev.id}`}
              class="group rounded-lg border border-[var(--color-border)] p-4 transition hover:border-[var(--color-accent)]"
            >
              <span class="flex items-center gap-1 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                <Icon name="chevron-left" size={12} /> Previous
              </span>
              <span class="mt-1 block font-medium group-hover:text-[var(--color-accent)]">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }
        {
          next && (
            <a
              href={`/ideas/${next.id}`}
              class="group rounded-lg border border-[var(--color-border)] p-4 text-right transition hover:border-[var(--color-accent)]"
            >
              <span class="flex items-center justify-end gap-1 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                Next <Icon name="chevron-right" size={12} />
              </span>
              <span class="mt-1 block font-medium group-hover:text-[var(--color-accent)]">
                {next.data.title}
              </span>
            </a>
          )
        }
      </nav>
    </div>

    {
      tocHeadings.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
              On this page
            </p>
            <ol class="mt-3 flex flex-col gap-2 text-sm">
              {tocHeadings.map((h) => (
                <li class={h.depth === 3 ? "pl-4" : ""}>
                  <a
                    href={`#${h.slug}`}
                    class="text-[var(--color-muted)] hover:text-[var(--color-accent)]"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )
    }
  </article>
</BaseLayout>
