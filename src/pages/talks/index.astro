---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import PillarBadge from "@/components/PillarBadge.astro";
import { formatDate } from "@/lib/format";
import { getTalks } from "@/lib/content";
import { blendKey, PILLAR_HEX } from "@/lib/pillar";
import type { CollectionEntry } from "astro:content";

const { upcoming, past } = await getTalks();

const eventJsonLd = upcoming.map((t) => ({
  "@context": "https://schema.org",
  "@type": "Event",
  name: t.data.title,
  startDate: t.data.date.toISOString(),
  location: {
    "@type": "Place",
    name: t.data.venue,
    address: { "@type": "PostalAddress", addressLocality: t.data.city, addressCountry: t.data.country },
  },
  description: t.data.abstract,
}));

function venueLine(t: CollectionEntry<"talk">) {
  return `${t.data.venue} - ${t.data.city}, ${t.data.country}`;
}
---

<BaseLayout
  title="Talks"
  description="Conference keynotes, AWS community days, and salon-evening idea talks - past and upcoming."
  jsonLd={eventJsonLd as unknown as Record<string, unknown>[]}
>
  <section class="mx-auto max-w-4xl px-4 py-20 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Talks</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
      <span class="rgb-text">On stage and at the lectern.</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-muted)]">
      Conference keynotes, AWS community days, meetup talks, and salon evenings - past and upcoming.
    </p>
  </section>

  {
    upcoming.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 pb-16 md:px-6">
        <h2 class="font-display text-2xl font-bold tracking-tight">Upcoming ({upcoming.length})</h2>
        <ul class="mt-6 flex flex-col gap-4">
          {upcoming.map((t) => {
            const accent = PILLAR_HEX[blendKey(t.data.pillars)];
            return (
              <li
                class="rounded-2xl border bg-[var(--color-bg-card)] p-6"
                style={`border-color: ${accent};`}
              >
                <p
                  class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest"
                  style={`color: ${accent};`}
                >
                  <Icon name="calendar" size={12} /> {formatDate(t.data.date)}
                </p>
                <h3 class="mt-2 font-display text-xl font-bold">{t.data.title}</h3>
                <p class="mt-1 flex items-center gap-1 text-sm text-[var(--color-muted)]">
                  <Icon name="map-pin" size={14} /> {venueLine(t)}
                </p>
                <p class="mt-3 text-[var(--color-fg)]">{t.data.abstract}</p>
                {t.data.pillars.length > 0 && (
                  <div class="mt-4">
                    <PillarBadge pillars={t.data.pillars} variant="solid" />
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 pb-24 md:px-6">
        <h2 class="font-display text-2xl font-bold tracking-tight">Past ({past.length})</h2>
        <ul class="mt-6 flex flex-col gap-4">
          {past.map((t) => {
            const accent = PILLAR_HEX[blendKey(t.data.pillars)];
            return (
              <li
                class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6"
                style={`border-left: 4px solid ${accent};`}
              >
                <p class="flex items-center gap-2 text-xs uppercase tracking-widest text-[var(--color-muted)]">
                  <Icon name="calendar" size={12} /> {formatDate(t.data.date)}
                </p>
                <h3 class="mt-2 font-display text-xl font-bold">{t.data.title}</h3>
                <p class="mt-1 flex items-center gap-1 text-sm text-[var(--color-muted)]">
                  <Icon name="map-pin" size={14} /> {venueLine(t)}
                </p>
                <p class="mt-3 text-[var(--color-fg)]">{t.data.abstract}</p>
                <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
                  {t.data.pillars.length > 0 && (
                    <PillarBadge pillars={t.data.pillars} variant="solid" />
                  )}
                  {t.data.slidesUrl && (
                    <a
                      href={t.data.slidesUrl}
                      rel="noopener"
                      class="inline-flex items-center gap-1 hover:underline"
                      style={`color: ${accent};`}
                    >
                      Slides <Icon name="external-link" size={14} />
                    </a>
                  )}
                  {t.data.recordingUrl && (
                    <a
                      href={t.data.recordingUrl}
                      rel="noopener"
                      class="inline-flex items-center gap-1 hover:underline"
                      style={`color: ${accent};`}
                    >
                      Recording <Icon name="external-link" size={14} />
                    </a>
                  )}
                  {t.data.locationSlug && (
                    <a
                      href={`/locations#${t.data.locationSlug.id}`}
                      class="inline-flex items-center gap-1 text-[var(--color-tech-change)] hover:underline"
                    >
                      On the map <Icon name="map-pin" size={14} />
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</BaseLayout>
