---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ProtectedEmail from "@/components/ProtectedEmail.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { site } from "@/lib/site";

const BOOKING_URL =
  "https://outlook.office.com/bookwithme/user/eae9d2c35f5842448c93534d3e3a9bad@lindamohamed.com/meetingtype/RUP6EGbn9kSiUnWGiSLdyg2?anonymous&ismsaljsauthenabled&ep=mlink";

const mailto = (topic: string) =>
  `mailto:${site.author.email}?subject=${encodeURIComponent("[" + topic + "] inquiry")}`;

const topics: { label: string; accent: string }[] = [
  { label: "Performance", accent: "var(--color-brain)" },
  { label: "Workshop", accent: "var(--color-brain-tech)" },
  { label: "Keynote", accent: "var(--color-tech)" },
  { label: "Idea Talk", accent: "var(--color-tech-change)" },
  { label: "Press", accent: "var(--color-brain-change)" },
  { label: "Other", accent: "var(--color-change)" },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch about a performance, workshop, keynote, or idea talk."
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:px-6 lg:px-10">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Contact</p>
    <h1 class="mt-2 font-display text-4xl font-bold tracking-tight md:text-6xl">
      <span class="rgb-text">Say hello.</span>
    </h1>
    <p class="mt-5 text-lg text-[var(--color-muted)]">
      Email is the fastest way to reach me. Pick the topic that fits and I'll usually
      reply within two working days. Or book a call directly if you'd rather talk first.
    </p>

    <ul class="mt-10 grid gap-3 md:grid-cols-2">
      {
        topics.map(({ label, accent }) => (
          <li>
            <a
              href={mailto(label)}
              class="card group flex h-full items-center justify-between gap-2 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 transition"
              style={`--card-accent: ${accent};`}
            >
              <span class="font-medium text-[var(--color-fg)]">{label}</span>
              <span style={`color: ${accent};`}>
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Booking -->
    <div class="mt-10 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">Book a call</p>
      <p class="mt-2 text-sm text-[var(--color-muted)]">
        Prefer a quick conversation before committing to an inquiry? Book a 30-minute slot
        to talk through your event, workshop, or idea directly.
      </p>
      <a
        href={BOOKING_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-[var(--color-bg)] transition-all"
        style="background: linear-gradient(135deg, var(--color-brain) 0%, var(--color-change) 100%);"
      >
        <Icon name="calendar" size={14} />
        Book a meeting
      </a>
    </div>

    <!-- Email and social -->
    <div class="mt-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6">
      <p class="flex items-center gap-2 text-sm text-[var(--color-muted)]">
        <Icon name="mail" size={16} />
        <ProtectedEmail
          user="hello"
          domain="lindamohamed.com"
          class="text-[var(--color-brain-tech)] hover:underline"
        />
      </p>
      <div class="mt-4">
        <SocialLinks variant="list" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .card { transition: border-color 200ms ease, box-shadow 220ms ease, transform 220ms ease; }
  .card:hover {
    border-color: var(--card-accent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-accent) 30%, transparent),
      0 12px 32px -16px color-mix(in oklab, var(--card-accent) 60%, transparent);
    transform: translateY(-2px);
  }
</style>
