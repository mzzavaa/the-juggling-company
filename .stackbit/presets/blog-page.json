{
    "model": "Page",
    "presets": [
        {
            "label": "Next.js Blog",
            "thumbnail": "images/page-blog.png",
            "data": {
                "title": "Next.js Blog",
                "sections": [
                    {
                        "type": "HeroSection",
                        "title": "Welcome to My Blog",
                        "text": "This is a blog built with Next.js. Stay tuned for more updates!",
                        "image": {
                            "type": "Image",
                            "url": "/images/blog-hero.jpg",
                            "altText": "Blog hero image"
                        }
                    },
                    {
                        "type": "BlogPostsSection",
                        "title": "Latest Posts",
                        "posts": [
                            {
                                "type": "BlogPost",
                                "title": "First Blog Post",
                                "excerpt": "This is the excerpt for the first blog post.",
                                "url": "/posts/first-post",
                                "image": {
                                    "type": "Image",
                                    "url": "/images/post-1.jpg",
                                    "altText": "First blog post image"
                                }
                            },
                            {
                                "type": "BlogPost",
                                "title": "Second Blog Post",
                                "excerpt": "This is the excerpt for the second blog post.",
                                "url": "/posts/second-post",
                                "image": {
                                    "type": "Image",
                                    "url": "/images/post-2.jpg",
                                    "altText": "Second blog post image"
                                }
                            }
                        ]
                    },
                    {
                        "type": "AboutSection",
                        "title": "About Me",
                        "text": "Hi, I'm a developer who loves to write about technology and programming. Follow my blog for more updates.",
                        "image": {
                            "type": "Image",
                            "url": "/images/about-me.jpg",
                            "altText": "About me image"
                        }
                    }
                ]
            }
        }
    ]
}