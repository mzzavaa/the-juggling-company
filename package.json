{
  "name": "the-juggling-company",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Juggling Company — static site built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/generate-animations.ts",
    "build": "astro build",
    "posters": "node scripts/generate-video-posters.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "linkcheck": "lychee --cache --max-cache-age 1d --no-progress --base ./dist './dist/**/*.html'",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,md,mdx,json,css}\"",
    "anim:generate": "tsx scripts/generate-animations.ts",
    "anim:regenerate": "tsx scripts/generate-animations.ts --force",
    "anim:single": "tsx scripts/generate-animations.ts --pattern"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "astro": "^7.2.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "0.474.0",
    "maplibre-gl": "5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "typescript": "5.7.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "yaml": ">=2.8.3"
  }
}
