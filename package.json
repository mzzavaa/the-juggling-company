{
  "name": "the-juggling-company",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Juggling Company — static site built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "linkcheck": "lychee --cache --max-cache-age 1d --no-progress --base ./dist './dist/**/*.html'",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,md,mdx,json,css}\""
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/mdx": "4.2.0",
    "@astrojs/react": "4.2.0",
    "@astrojs/rss": "4.0.11",
    "@astrojs/sitemap": "3.2.1",
    "@tailwindcss/vite": "4.1.18",
    "astro": "5.2.5",
    "lucide-react": "0.474.0",
    "maplibre-gl": "5.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.7.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prettier": "3.4.2",
    "prettier-plugin-astro": "0.14.1"
  }
}
